---
// src/components/ui/Card.astro
interface Props {
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  rounded?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl';
  hover?: boolean;
  href?: string;
  id?: string;
  /** Passed through to the root element (e.g. booking payload for modal). */
  'data-booking'?: string;
}

const {
  class: className,
  padding = 'md',
  rounded = '2xl',
  hover = false,
  href,
  id,
  'data-booking': dataBooking,
} = Astro.props;

const paddings = {
  none: "",
  sm: "p-4 md:p-6",
  md: "p-6 md:p-8",
  lg: "p-8 md:p-12",
  xl: "p-10 md:p-16"
};

const roundness = {
  sm: "rounded-sm md:rounded",
  md: "rounded md:rounded-md",
  lg: "rounded-md md:rounded-lg",
  xl: "rounded-lg md:rounded-xl",
  "2xl": "rounded-[var(--radius)]",
  "3xl": "rounded-[calc(var(--radius)+8px)]"
};

const baseClasses = "bg-card border border-border text-card-foreground relative z-10 transition-all block";
const hoverClasses = (hover || href) ? "hover:border-primary/50 hover:shadow-md cursor-pointer" : "";

const Element = href ? 'a' : 'div';
---

<Element
  id={id}
  href={href}
  data-booking={dataBooking}
  class:list={[baseClasses, roundness[rounded], paddings[padding], hoverClasses, className]}
>
  <slot />
</Element>

<style>
</style>

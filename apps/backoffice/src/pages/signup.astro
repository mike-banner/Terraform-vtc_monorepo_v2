---
// src/pages/signup.astro
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Inscription" hideFooter>
	<div class="flex-1 flex items-center justify-center px-4 py-2 relative z-10">
		<div class="bg-card/30 backdrop-blur-md p-6 sm:p-8 rounded-[2.5rem] w-full max-w-xl shadow-2xl border border-border/50 animate-in fade-in slide-in-from-bottom-4 duration-700">
			<!-- Step Indicators -->
			<div class="flex justify-between mb-6 relative px-2">
				<div class="absolute top-1/2 left-0 w-full h-0.5 bg-border -translate-y-1/2"></div>
				<div id="progress-bar" class="absolute top-1/2 left-0 h-0.5 bg-primary -translate-y-1/2 transition-all duration-500 ease-in-out" style="width: 0%"></div>
				{
					[1, 2, 3].map((step) => (
						<div
							class="step-dot w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-background border border-border flex items-center justify-center text-[10px] sm:text-xs font-bold text-muted-foreground z-10 transition-all duration-500"
							data-step={step}
						>
							{step}
						</div>
					))
				}
			</div>

			<div class="text-center mb-6 h-[60px]">
				<div class="step-header" data-step="1">
					<h1 class="text-2xl sm:text-3xl font-heading font-black mb-1 text-foreground uppercase tracking-tight">Compte</h1>
					<p class="text-muted-foreground text-[10px] font-bold uppercase tracking-widest">Tes identifiants de connexion</p>
				</div>
				<div class="step-header hidden" data-step="2">
					<h1 class="text-2xl sm:text-3xl font-heading font-black mb-1 text-foreground uppercase tracking-tight">Profil</h1>
					<p class="text-muted-foreground text-[10px] font-bold uppercase tracking-widest">Identité du titulaire</p>
				</div>
				<div class="step-header hidden" data-step="3">
					<h1 class="text-2xl sm:text-3xl font-heading font-black mb-1 text-foreground uppercase tracking-tight">Entreprise</h1>
					<p class="text-muted-foreground text-[10px] font-bold uppercase tracking-widest">Détails juridiques & PRO</p>
				</div>
			</div>

			<form id="signup-form" class="space-y-4">
				<!-- Step 1: Account -->
				<div class="step-content space-y-3" data-step="1">
					<div class="space-y-1.5">
						<label for="email" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider ml-1">Email professionnel</label>
						<input type="email" id="email" name="email" required placeholder="nom@entreprise.fr" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all text-sm" />
					</div>
					<div class="space-y-1.5">
						<label for="password" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider ml-1">Mot de passe</label>
						<div class="relative">
							<input type="password" id="password" name="password" required placeholder="••••••••" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 pr-11 text-foreground placeholder:text-muted-foreground/50 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all text-sm" />
							<button type="button" id="toggle-password" aria-label="Afficher le mot de passe" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors p-1">
								<svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
									<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
								</svg>
								<svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 hidden">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
								</svg>
							</button>
						</div>
					</div>
				</div>

				<!-- Step 2: Profile -->
				<div class="step-content space-y-4 hidden" data-step="2">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<div class="space-y-1.5">
							<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider px-1">Prénom</label>
							<input type="text" name="first_name" required placeholder="Jean" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all text-sm" />
						</div>
						<div class="space-y-1.5">
							<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider px-1">Nom</label>
							<input type="text" name="last_name" required placeholder="Dupont" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all text-sm" />
						</div>
					</div>
					<div class="space-y-1.5">
						<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider px-1">Téléphone</label>
						<div class="flex items-center bg-card/50 border border-border rounded-[var(--radius)] focus-within:ring-1 focus-within:ring-primary focus-within:border-primary transition-all overflow-hidden h-[42px]">
							<div class="flex items-center gap-2 px-3 border-r border-border shrink-0 h-full bg-card/80">
								<span class="text-sm leading-none">🇫🇷</span>
								<span class="font-bold text-xs tracking-tighter opacity-80">+33</span>
							</div>
							<input type="tel" name="phone_number" id="phone_number_input" required placeholder="6 12 34 56 78" inputmode="numeric" maxlength="14" class="flex-1 bg-transparent border-none outline-none px-3 text-foreground placeholder:text-muted-foreground/50 text-sm h-full" />
							<input type="hidden" name="phone_prefix" value="+33" />
						</div>
					</div>
				</div>

				<!-- Step 3: Business -->
				<div class="step-content space-y-3 hidden" data-step="3">
					<div class="space-y-1.5">
						<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider ml-1">Type d'entreprise</label>
						<div class="grid grid-cols-2 gap-2 bg-card/50 p-1 rounded-[var(--radius)] border border-border">
							<button type="button" class="legal-form-toggle-btn py-2 text-[10px] font-bold uppercase rounded-[calc(var(--radius)-4px)] transition-all active bg-primary shadow-sm shadow-primary/20 text-primary-foreground" data-type="societe">
								Société
							</button>
							<button type="button" class="legal-form-toggle-btn py-2 text-[10px] font-bold uppercase rounded-[calc(var(--radius)-4px)] transition-all text-muted-foreground hover:text-foreground hover:bg-card/80" data-type="auto_entrepreneur">
								Auto-entrepreneur
							</button>
						</div>
						<input type="hidden" name="legal_form" id="legal_form" value="sasu" />
					</div>

					<!-- Sous-type de société (masqué pour AE) -->
					<div id="societe-details" class="space-y-3 animate-in fade-in slide-in-from-top-2 duration-300">
						<div class="space-y-1.5">
							<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider ml-1">Type de société</label>
							<div class="relative group h-[42px]">
								<select id="legal_form_select" class="w-full h-full bg-card/50 border border-border rounded-[var(--radius)] px-4 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary appearance-none cursor-pointer pr-10 text-sm">
									<option value="sasu" selected>SASU</option>
									<option value="eurl">EURL</option>
									<option value="sarl">SARL</option>
									<option value="sas">SAS</option>
									<option value="ei">Entreprise Individuelle (EI)</option>
									<option value="other">Autre</option>
								</select>
								<div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground group-hover:text-foreground transition-colors">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
									</svg>
								</div>
							</div>
						</div>
					</div>
					<div class="space-y-1.5">
						<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider ml-1">Nom de l'entreprise</label>
						<input type="text" id="company_name_input" name="company_name" required placeholder="Ex: Prestige VTC" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm" />
					</div>
					<div class="space-y-1.5">
						<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider ml-1">Domaine web (prestige-vtc)</label>
						<input type="text" name="primary_domain" required placeholder="prestige-vtc" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm" />
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<div class="space-y-1.5">
							<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider ml-1">SIRET (14 chiffres)</label>
							<input type="text" name="siret" id="siret_input" required placeholder="123 456 789 00012" pattern="[0-9 ]{14,18}" maxlength="18" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-[13px] sm:text-sm" />
						</div>
						<div class="space-y-1.5">
							<label class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider ml-1">Carte VTC</label>
							<input type="text" name="vtc_license_number" id="vtc_input" required placeholder="123 456 789 012" pattern="[0-9 ]{14,15}" maxlength="15" class="w-full bg-card/50 border border-border rounded-[var(--radius)] px-4 py-2.5 text-foreground focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-[13px] sm:text-sm" />
						</div>
					</div>
				</div>

				<div class="flex flex-col sm:flex-row gap-3 pt-2">
					<button type="button" id="prev-btn" class="w-full sm:flex-1 bg-card hover:bg-card/80 text-foreground text-[11px] font-bold uppercase tracking-wider h-10 rounded-[var(--radius)] transition-all opacity-0 pointer-events-none border border-border">
						Retour
					</button>
					<button type="button" id="next-btn" class="w-full sm:flex-1 bg-primary hover:bg-primary/90 text-primary-foreground text-[11px] font-bold uppercase tracking-wider h-10 rounded-[var(--radius)] shadow-sm shadow-primary/20 transition-all">
						Suivant
					</button>
					<button type="submit" id="final-btn" class="w-full sm:flex-1 bg-primary hover:bg-primary/90 text-primary-foreground text-[11px] font-bold uppercase tracking-wider h-10 rounded-[var(--radius)] shadow-sm shadow-primary/20 transition-all hidden relative overflow-hidden group">
						<span class="btn-text">Finaliser</span>
						<div class="loader-container hidden absolute inset-0 flex items-center justify-center bg-primary">
							<svg class="animate-spin h-4 w-4 text-primary-foreground" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</div>
					</button>
				</div>
			</form>

			<div id="message" role="alert" aria-live="polite" class="mt-4 text-center text-[10px] font-bold min-h-[16px] uppercase tracking-widest">
			</div>
		</div>
	</div>
</MainLayout>

<script>
	import { supabase } from "@/lib/supabase/client";

	let currentStep = 1;
	const totalSteps = 3;

	const form = document.querySelector("#signup-form") as HTMLFormElement;
	const contents = document.querySelectorAll(".step-content");
	const headers = document.querySelectorAll(".step-header");
	const dots = document.querySelectorAll(".step-dot");
	const progressBar = document.getElementById("progress-bar") as HTMLDivElement;

	const nextBtn = document.querySelector("#next-btn") as HTMLButtonElement;
	const prevBtn = document.querySelector("#prev-btn") as HTMLButtonElement;
	const finalBtn = document.querySelector("#final-btn") as HTMLButtonElement;

	const messageEl = document.querySelector("#message") as HTMLDivElement;
	const loader = document.querySelector(".loader-container") as HTMLDivElement;
	const btnText = document.querySelector(".btn-text") as HTMLSpanElement;

	const legalFormToggleBtns = document.querySelectorAll(".legal-form-toggle-btn");
	const legalFormInput = document.getElementById("legal_form") as HTMLInputElement;
	const legalFormSelect = document.getElementById("legal_form_select") as HTMLSelectElement;
	const societeDetails = document.getElementById("societe-details") as HTMLDivElement;

	const siretInput = document.getElementById("siret_input") as HTMLInputElement;
	const phoneInput = document.getElementById("phone_number_input") as HTMLInputElement;
	const vtcInput = document.getElementById("vtc_input") as HTMLInputElement;

	// Visual Formatter Logic
	const formatInput = (input: HTMLInputElement, spacing: number) => {
		input?.addEventListener("input", (e: any) => {
			let cursorPosition = e.target.selectionStart;
			let value = e.target.value.replace(/[^0-9]/g, "");
			let formatted = "";

			for (let i = 0; i < value.length; i++) {
				if (i > 0 && i % spacing === 0) formatted += " ";
				formatted += value[i];
			}

			const oldLength = e.target.value.length;
			e.target.value = formatted;
			const newLength = formatted.length;

			// Adjust cursor position
			if (cursorPosition) {
				cursorPosition += (newLength - oldLength);
				e.target.setSelectionRange(cursorPosition, cursorPosition);
			}
		});
	};

	// Apply formatters
	formatInput(phoneInput, 2); // 6 12 34 56 78
	formatInput(siretInput, 3); // 123 456 789 00012
	formatInput(vtcInput, 3);   // 123 456 789

	// Handle legal form selection
	legalFormToggleBtns.forEach(btn => {
		btn.addEventListener("click", () => {
			const type = btn.getAttribute("data-type") || "societe";

			if (type === "auto_entrepreneur") {
				legalFormInput.value = "auto_entrepreneur";
				societeDetails.classList.add("hidden");
			} else {
				legalFormInput.value = legalFormSelect.value || "sasu";
				societeDetails.classList.remove("hidden");
			}

			legalFormToggleBtns.forEach((b: any) => {
				b.classList.remove("active", "bg-primary", "shadow-md", "shadow-primary/20", "text-primary-foreground");
				b.classList.add("text-muted-foreground", "hover:text-foreground", "hover:bg-card/80");
			});
			btn.classList.add("active", "bg-primary", "shadow-md", "shadow-primary/20", "text-primary-foreground");
			btn.classList.remove("text-muted-foreground", "hover:text-foreground", "hover:bg-card/80");
		});
	});

	legalFormSelect.addEventListener("change", () => {
		legalFormInput.value = legalFormSelect.value;
	});

	let sessionUser: any = null;
	let existingOnboarding: any = null;

	async function init() {
		const { data: { user } } = await supabase.auth.getUser();
		if (user) {
			sessionUser = user;
			const emailInput = document.getElementById("email") as HTMLInputElement;
			const passwordInput = document.getElementById("password") as HTMLInputElement;
			if (emailInput) {
				emailInput.value = user.email || "";
				emailInput.disabled = true;
			}
			if (passwordInput) {
				passwordInput.required = false;
				(passwordInput.parentElement as HTMLElement).classList.add("hidden");
			}

			// Check for existing pending onboarding
			const { data: onboarding } = await supabase
				.from("onboarding")
				.select("*")
				.eq("profile_id", user.id)
				.maybeSingle();

			if (onboarding) {
				existingOnboarding = onboarding;
				// Pre-fill form
				(document.getElementsByName("first_name")[0] as HTMLInputElement).value = onboarding.first_name || "";
				(document.getElementsByName("last_name")[0] as HTMLInputElement).value = onboarding.last_name || "";
				(document.getElementsByName("company_name")[0] as HTMLInputElement).value = onboarding.company_name || "";
				(document.getElementsByName("primary_domain")[0] as HTMLInputElement).value = onboarding.primary_domain || "";
				(document.getElementsByName("siret")[0] as HTMLInputElement).value = onboarding.siret || "";
				(document.getElementsByName("vtc_license_number")[0] as HTMLInputElement).value = onboarding.vtc_license_number || "";

				if (onboarding.legal_form || onboarding.company_type) {
					const val = onboarding.legal_form || (onboarding.company_type === 'auto_entrepreneur' ? 'auto_entrepreneur' : 'sasu');
					if (val === "auto_entrepreneur") {
						const btn = document.querySelector(`.legal-form-toggle-btn[data-type="auto_entrepreneur"]`) as HTMLButtonElement;
						if (btn) btn.click();
					} else {
						const btn = document.querySelector(`.legal-form-toggle-btn[data-type="societe"]`) as HTMLButtonElement;
						if (btn) btn.click();
						legalFormSelect.value = val;
						legalFormInput.value = val;
					}
				}

				if (onboarding.phone) {
					// Split phone if it starts with prefix
					const phone = onboarding.phone;
					if (phone.startsWith("+33")) {
						(document.getElementsByName("phone_prefix")[0] as HTMLSelectElement).value = "+33";
						(document.getElementsByName("phone_number")[0] as HTMLInputElement).value = phone.replace("+33", "");
					} else if (phone.startsWith("+32")) {
						(document.getElementsByName("phone_prefix")[0] as HTMLSelectElement).value = "+32";
						(document.getElementsByName("phone_number")[0] as HTMLInputElement).value = phone.replace("+32", "");
					} else if (phone.startsWith("+41")) {
						(document.getElementsByName("phone_prefix")[0] as HTMLSelectElement).value = "+41";
						(document.getElementsByName("phone_number")[0] as HTMLInputElement).value = phone.replace("+41", "");
					} else {
						(document.getElementsByName("phone_number")[0] as HTMLInputElement).value = phone;
					}
				}
			}

			currentStep = 2;
		}
		updateUI();
	}

	function updateUI() {
		contents.forEach((el) => {
			const step = parseInt(el.getAttribute("data-step")!);
			el.classList.toggle("hidden", step !== currentStep);
		});
		headers.forEach((el) => {
			const step = parseInt(el.getAttribute("data-step")!);
			el.classList.toggle("hidden", step !== currentStep);
		});
		dots.forEach((dot) => {
			const step = parseInt(dot.getAttribute("data-step")!);
			if (step <= currentStep) {
				dot.classList.add("border-primary", "bg-primary/10", "text-primary");
				dot.classList.remove("border-border", "text-muted-foreground");
			} else {
				dot.classList.remove("border-primary", "bg-primary/10", "text-primary");
				dot.classList.add("border-border", "text-muted-foreground");
			}
		});

		const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
		progressBar.style.width = `${progress}%`;

		prevBtn.style.opacity = currentStep === 1 ? "0" : "1";
		prevBtn.style.pointerEvents = currentStep === 1 ? "none" : "auto";

		if (currentStep === totalSteps) {
			nextBtn.classList.add("hidden");
			finalBtn.classList.remove("hidden");
		} else {
			nextBtn.classList.remove("hidden");
			finalBtn.classList.add("hidden");
		}
	}

	nextBtn.addEventListener("click", () => {
		// Basic validation for current step
		const inputs = contents[currentStep - 1].querySelectorAll("input");
		let valid = true;
		inputs.forEach(input => {
			if (!input.checkValidity()) {
				input.reportValidity();
				valid = false;
			}
		});

		if (valid && currentStep < totalSteps) {
			currentStep++;
			updateUI();
		}
	});

	prevBtn.addEventListener("click", () => {
		if (currentStep > 1) {
			currentStep--;
			updateUI();
		}
	});

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();

		const formData = new FormData(form);
		const email = formData.get("email") as string;
		const password = formData.get("password") as string;

		// UI State: Loading
		finalBtn.disabled = true;
		loader.classList.remove("hidden");
		btnText.style.opacity = "0";
		messageEl.textContent = "CRÉATION DU COMPTE...";
		messageEl.className = "mt-6 text-center text-[10px] font-bold uppercase tracking-widest text-primary";

		try {
			let userId = sessionUser?.id;

			if (!userId) {
				// 1. Auth SignUp
				const { data: authData, error: authError } = await supabase.auth.signUp({
					email,
					password,
				});

				if (authError) throw authError;
				if (!authData.user) throw new Error("Erreur lors de la création de l'utilisateur");
				userId = authData.user.id;
			}

			messageEl.textContent = existingOnboarding ? "MISE À JOUR DOSSIER..." : "ENREGISTREMENT DOSSIER...";

			// 2. Prepare Onboarding Data
			const phonePrefix = formData.get("phone_prefix") as string;
			const phoneNumber = (formData.get("phone_number") as string).replace(/\s/g, "").replace(/[^0-9]/g, "");
			const fullPhone = `${phonePrefix}${phoneNumber}`;

			const onboardingData: any = {
				profile_id: userId,
				first_name: formData.get("first_name") as string,
				last_name: formData.get("last_name") as string,
				company_name: formData.get("company_name") as string,
				primary_domain: formData.get("primary_domain") as string,
				phone: fullPhone,
				vtc_license_number: (formData.get("vtc_license_number") as string).replace(/[^0-9]/g, ""),
				siret: (formData.get("siret") as string).replace(/[^0-9]/g, ""),
				legal_form: formData.get("legal_form") as string,
				status: "pending",
			};

			// 3. Uniqueness checks

			// a) Domain in tenants
			const { data: existingTenantDomain } = await supabase
				.from("tenants")
				.select("id")
				.eq("primary_domain", onboardingData.primary_domain)
				.maybeSingle();
			if (existingTenantDomain) {
				throw new Error(`Le domaine "${onboardingData.primary_domain}" est déjà réservé.`);
			}

			// b) SIRET Cross-Check (Onboarding + Production)
			const { data: existingOnboardingSiret } = await supabase
				.from("onboarding")
				.select("id")
				.eq("siret", onboardingData.siret)
				.neq("status", "rejected")
				.maybeSingle();

			if (existingOnboardingSiret && (!existingOnboarding || existingOnboardingSiret.id !== existingOnboarding.id)) {
				throw new Error("Ce numéro SIRET est déjà associé à un dossier en cours ou validé.");
			}

			const { data: prodTenantSiret } = await supabase
				.from("tenants")
				.select("id")
				.eq("siret", onboardingData.siret)
				.maybeSingle();
			if (prodTenantSiret) {
				throw new Error("Ce numéro SIRET est déjà enregistré sur la plateforme.");
			}

			// c) VTC License Cross-Check (Onboarding + Production)
			const { data: existingOnboardingVtc } = await supabase
				.from("onboarding")
				.select("id")
				.eq("vtc_license_number", onboardingData.vtc_license_number)
				.neq("status", "rejected")
				.maybeSingle();

			if (existingOnboardingVtc && (!existingOnboarding || existingOnboardingVtc.id !== existingOnboarding.id)) {
				throw new Error("Cette carte VTC est déjà associée à un dossier en cours ou validé.");
			}

			const { data: prodDriverVtc } = await supabase
				.from("drivers")
				.select("id")
				.eq("license_number", onboardingData.vtc_license_number)
				.maybeSingle();
			if (prodDriverVtc) {
				throw new Error("Cette carte VTC est déjà enregistrée sur la plateforme.");
			}

			// 4. Insert or Update Onboarding Record
			let res;
			if (existingOnboarding) {
				res = await supabase
					.from("onboarding")
					.update(onboardingData)
					.eq("id", existingOnboarding.id);
			} else {
				res = await supabase
					.from("onboarding")
					.insert(onboardingData);
			}

			if (res.error) throw res.error;

			// 4. Welcome Email (silent)
			try {
				await supabase.functions.invoke("send-email", {
					body: {
						to: email,
						subject: "Inscription VTC MVP Réussie ! 🚀",
						html: `<h1>Bienvenue !</h1><p>Ton dossier est en cours de validation par nos administrateurs.</p>`
					}
				});
			} catch (e) { console.error("Email fail", e); }

			messageEl.textContent = "SUCCÈS ! REDIRECTION...";
			messageEl.className = "mt-6 text-center text-[10px] font-bold uppercase tracking-widest text-emerald-500";

			setTimeout(() => {
				window.location.href = "/waiting-approval";
			}, 1500);

		} catch (err: any) {
			console.error(err);
			messageEl.textContent = "ERREUR : " + (err.message || "Technique");
			messageEl.className = "mt-6 text-center text-[10px] font-bold uppercase tracking-widest text-destructive";
			finalBtn.disabled = false;
			loader.classList.add("hidden");
			btnText.style.opacity = "1";
		}
	});

	const togglePasswordBtn = document.querySelector("#toggle-password") as HTMLButtonElement;
	const passwordField = document.querySelector("#password") as HTMLInputElement;
	const eyeIconEl = document.querySelector("#eye-icon") as SVGElement;
	const eyeOffIconEl = document.querySelector("#eye-off-icon") as SVGElement;

	togglePasswordBtn?.addEventListener("click", () => {
		const isHidden = passwordField.type === "password";
		passwordField.type = isHidden ? "text" : "password";
		eyeIconEl.classList.toggle("hidden", isHidden);
		eyeOffIconEl.classList.toggle("hidden", !isHidden);
	});

	init();
</script>

---
// src/pages/app/profile.astro
import { DriverList } from "@/components/drivers/DriverList";
import { EditableDriverCard } from "@/components/profile/EditableDriverCard";
import Badge from "../../components/ui/Badge.astro";
import Card from "../../components/ui/Card.astro";
import AppLayout from "../../layouts/AppLayout.astro";

const { profile, supabase: supabaseAdmin } = Astro.locals;

if (!profile) return Astro.redirect("/login");

// 1. Récupérer les infos du tenant
const { data: tenant } = await supabaseAdmin
    .from("tenants")
    .select("*")
    .eq("id", profile.tenant_id!)
    .maybeSingle();

if (!tenant) return Astro.redirect("/login");

// 2. Récupérer les infos du chauffeur principal (l'utilisateur connecté)
// Priorité : user_id lié → sinon premier driver non-lié du tenant (cas onboarding legacy)
let { data: driverFull } = await supabaseAdmin
    .from("drivers")
    .select("*, vehicles(*)")
    .eq("user_id", profile.id)
    .maybeSingle();

if (!driverFull && profile.tenant_id) {
    const { data: fallback } = await supabaseAdmin
        .from("drivers")
        .select("*, vehicles(*)")
        .eq("tenant_id", profile.tenant_id)
        .is("user_id", null)
        .order("created_at", { ascending: true })
        .maybeSingle();
    driverFull = fallback;
}

const isAuto = tenant.legal_form === 'auto_entrepreneur';

const tenantName = tenant?.name || "VTC HUB";
const logoUrl = tenant?.logo_url;
---

<AppLayout title="Profil">
    <div class="flex flex-col px-6 py-10 md:p-12" id="profile-page" data-confirmation-phrase={`SUPPRESSION COMPTE ${tenantName}`}>
        <!-- HEADER -->
        <div class="mb-10 flex-shrink-0">
             <span class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] font-black tracking-widest text-primary uppercase">Mon Compte</span>
        </div>

        <!-- 🏢 CARD 1: PROFIL ENTREPRISE (FULL WIDTH) -->
        <Card class="mb-10">
            <div class="flex flex-row items-center md:items-start gap-4 md:gap-6 text-left">
                <!-- Logo -->
                {logoUrl ? (
                    <div class="flex w-12 h-12 md:w-16 md:h-16 bg-white rounded-xl p-2 md:p-2.5 items-center justify-center border border-white/10 flex-shrink-0">
                        <img src={logoUrl} alt={tenantName} class="w-full h-full object-contain" />
                    </div>
                ) : (
                    <div class="flex w-12 h-12 md:w-16 md:h-16 bg-primary rounded-xl items-center justify-center text-primary-foreground font-black text-lg md:text-2xl flex-shrink-0">
                        {tenantName.charAt(0).toUpperCase()}
                    </div>
                )}

                <div class="flex-1 min-w-0">
                    <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 mb-5">
                        <h2 class="text-xl md:text-2xl font-heading font-black text-foreground uppercase tracking-tight leading-none truncate">{tenantName}</h2>
                        <Badge variant="emerald">Compte Vérifié</Badge>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
                        <div>
                            <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest mb-1">SIRET</p>
                            <p class="text-sm font-semibold text-foreground tabular-nums">{tenant.siret?.trim() || "—"}</p>
                        </div>

                        {isAuto ? (
                            <div>
                                <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest mb-1">Fiscalité</p>
                                <p class="text-sm font-semibold text-primary uppercase tracking-tighter">Exonéré (Art. 293 B)</p>
                            </div>
                        ) : (
                            <>
                                <div>
                                    <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest mb-1">RCS</p>
                                    <p class="text-sm font-semibold text-foreground truncate">{tenant.rcs_number?.trim() || "—"}</p>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest mb-1">TVA</p>
                                    <p class="text-sm font-semibold text-foreground tabular-nums">{tenant.vat_number?.trim() || "—"}</p>
                                </div>
                            </>
                        )}
                    </div>
                </div>
            </div>
        </Card>

        <!-- 👤 SECTION 2: CHAUFFEUR PRINCIPAL -->
        <div class="mb-12">
            <p class="text-xs font-bold text-muted-foreground uppercase tracking-widest mb-4">Chauffeur Principal</p>

                <EditableDriverCard
                    client:only="react"
                    profile={profile}
                    driver={driverFull}
                />
        </div>

        <!-- 👥 SECTION 3: COLLABORATEURS -->
        <div class="mb-12">
            <DriverList client:only="react" tenantId={profile.tenant_id!} userId={profile.id} hidePrimary={true} isOwner={profile.tenant_role === 'owner'} />
        </div>

        <!-- ⚠️ ZONE DE DANGER -->
        <div class="pb-20">
            <div class="bg-card border border-red-500/10 rounded-2xl p-6">
                <h3 class="text-sm font-black mb-2 text-red-500 uppercase tracking-tighter">Zone de Danger</h3>
                <p class="text-muted-foreground mb-5 text-sm font-medium">
                    La suppression désactivera votre société, votre accès au dashboard et toutes vos données. Irréversible.
                </p>
                <button
                    id="open-delete-modal"
                    class="px-6 py-3 bg-red-500/10 border border-red-500/20 text-red-500 text-[10px] font-black uppercase tracking-widest rounded-2xl hover:bg-red-500 hover:text-white transition-all active:scale-95"
                >
                    Supprimer le compte entreprise
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL SUPPRESSION -->
    <div slot="modals" id="delete-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300">
        <div class="absolute inset-0 bg-background/80 backdrop-blur-sm delete-modal-overlay"></div>
        <div class="relative bg-card border border-red-500/20 max-w-lg w-full rounded-[calc(var(--radius)+8px)] shadow-2xl p-6 md:p-8 transform scale-95 transition-all duration-300">
            <div class="w-12 h-12 bg-red-500/10 border border-red-500/20 rounded-xl flex items-center justify-center text-red-500 mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h2 class="text-xl font-heading font-black uppercase text-foreground mb-2 tracking-tight">Confirmation de suppression</h2>
            <p class="text-muted-foreground text-sm font-medium mb-5 leading-relaxed">
                Suppression définitive du compte :<br/>
                <strong class="text-red-500 uppercase tracking-tighter block mt-1">{tenantName}</strong>
            </p>
            <div class="bg-red-500/5 border border-red-500/10 rounded-xl p-4 mb-5">
                <p class="text-[10px] font-black uppercase tracking-widest text-red-400 mb-2">Phrase de confirmation :</p>
                <p class="text-foreground font-mono text-sm font-bold bg-black/40 p-3 rounded-lg border border-white/5 select-all">
                    SUPPRESSION COMPTE {tenantName}
                </p>
            </div>
            <input
                type="text"
                id="confirmation-input"
                placeholder="Écrire la phrase de confirmation"
                class="w-full bg-background border border-border rounded-[var(--radius)] px-4 py-3 text-foreground focus:border-red-500/50 focus:outline-none focus:ring-1 focus:ring-red-500/50 font-bold mb-6 transition-all"
            />
            <div class="flex flex-col sm:flex-row gap-3">
                <button id="cancel-delete" class="px-6 py-3 bg-background hover:bg-muted border border-border rounded-[var(--radius)] font-bold uppercase tracking-widest text-muted-foreground hover:text-foreground transition-all text-[10px] order-2 sm:order-1">
                    Annuler
                </button>
                <button id="confirm-delete-btn" disabled
                    class="flex-1 px-6 py-3 bg-red-600/20 border border-red-600/20 text-red-600/40 rounded-[var(--radius)] font-bold uppercase tracking-widest text-[10px] transition-all disabled:cursor-not-allowed order-1 sm:order-2">
                    Supprimer définitivement
                </button>
            </div>
        </div>
    </div>

    <style is:global>
        #delete-modal.is-active { opacity: 1; pointer-events: auto; }
        #delete-modal.is-active > div:last-child { transform: scale(1); }
    </style>

    <script>
        import { supabase } from "@/lib/supabase/client";
        const page = document.getElementById('profile-page');
        const confirmationPhrase = page?.getAttribute('data-confirmation-phrase') ?? '';
        const modal = document.getElementById('delete-modal');
        const openBtn = document.getElementById('open-delete-modal');
        const cancelBtn = document.getElementById('cancel-delete');
        const confirmBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement | null;
        const input = document.getElementById('confirmation-input') as HTMLInputElement | null;
        const overlay = document.querySelector('.delete-modal-overlay');

        const toggleModal = () => {
            modal?.classList.toggle('is-active');
            document.body.classList.toggle('overflow-hidden');
            if (modal?.classList.contains('is-active') && input && confirmBtn) {
                input.value = '';
                confirmBtn.disabled = true;
                confirmBtn.className = confirmBtn.className.replace('bg-red-600 text-white hover:bg-red-500', 'bg-red-600/20 text-red-600/40');
            }
        };
        openBtn?.addEventListener('click', toggleModal);
        cancelBtn?.addEventListener('click', toggleModal);
        overlay?.addEventListener('click', toggleModal);
        window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal?.classList.contains('is-active')) toggleModal(); });

        input?.addEventListener('input', () => {
            if (!confirmBtn) return;
            const match = input.value === confirmationPhrase;
            confirmBtn.disabled = !match;
            confirmBtn.classList.toggle('bg-red-600', match);
            confirmBtn.classList.toggle('text-white', match);
            confirmBtn.classList.toggle('hover:bg-red-500', match);
            confirmBtn.classList.toggle('bg-red-600/20', !match);
            confirmBtn.classList.toggle('text-red-600/40', !match);
        });

        confirmBtn?.addEventListener('click', async () => {
            if (!confirmBtn) return;
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'SUPPRESSION...';
            try {
                const { error } = await supabase.functions.invoke('delete-tenant-account');
                if (error) throw error;
                await supabase.auth.signOut();
                window.location.href = '/';
            } catch (err: any) {
                alert('Erreur : ' + err.message);
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Supprimer définitivement';
            }
        });
    </script>
</AppLayout>

---
// src/pages/login.astro
import "../styles/global.css";
// --- (On n'utilise plus MainLayout ici pour prendre tout l'écran comme demandé dans le design) ---
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumière - Fleet Command Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
</head>
<body class="bg-background font-sans text-foreground overflow-x-hidden m-0 p-0">
  <div class="flex min-h-screen w-full">
    <!-- Left Panel (Image) -->
    <div class="hidden w-1/2 md:block relative overflow-hidden bg-muted">
      <div class="absolute inset-0 bg-gradient-to-r from-background/10 to-background/50 z-10"></div>
      <img
        src="https://ggrhecslgdflloszjkwl.supabase.co/storage/v1/object/public/user-assets/2Bqj2cwNjcn/components/M3imtwOrD0n.png"
        alt="Luxury car motion blur"
        class="h-full w-full object-cover"
      />
      <div class="absolute bottom-12 left-12 z-20 max-w-md">
        <a href="/" class="flex items-center gap-2 mb-6 text-primary hover:opacity-80 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><circle cx="12" cy="12" r="9"/><path d="M12 12v-9"/><path d="M12 12l-7.75 4.5"/><path d="M12 12l7.75 4.5"/><path d="M12 12v3"/><circle cx="12" cy="15" r="2"/></svg>
          <span class="font-heading text-2xl font-semibold text-white tracking-wide">
            VTC HUB
          </span>
        </a>
        <p class="text-white/80 text-lg leading-relaxed font-light">
          The premium command center for elite chauffeur fleets. Manage your vehicles, drivers,
          and clientele with unparalleled precision.
        </p>
      </div>
    </div>

    <!-- Right Panel (Form) -->
    <div class="flex w-full md:w-1/2 flex-col items-center justify-center px-6 py-4 lg:p-12 relative">
      <div class="w-full max-w-[400px] flex flex-col gap-4">
        
        <!-- Mobile Logo (in flow) -->
        <a href="/" class="flex md:hidden items-center justify-center gap-2 text-primary hover:opacity-80 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><circle cx="12" cy="12" r="9"/><path d="M12 12v-9"/><path d="M12 12l-7.75 4.5"/><path d="M12 12l7.75 4.5"/><path d="M12 12v3"/><circle cx="12" cy="15" r="2"/></svg>
          <span class="font-heading text-xl font-semibold text-foreground tracking-wide">
            VTC HUB
          </span>
        </a>

        <div class="space-y-1 text-center md:text-left mb-1">
          <h1 class="font-heading text-xl md:text-2xl font-bold tracking-tight text-foreground">
            Espace Gestion
          </h1>
          <p class="text-[11px] text-muted-foreground/80">
            Connectez-vous pour continuer.
          </p>
        </div>

        <form id="login-form" action="/api/auth/login" method="POST" class="space-y-3">
          <div class="space-y-3">
            <div class="space-y-1 relative group">
              <label for="email" class="text-[11px] font-medium text-muted-foreground ml-1">
                Adresse email
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground group-focus-within:text-primary transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="contact@vtc.fr"
                  class="flex h-10 w-full rounded-[var(--radius)] border border-border bg-card/50 backdrop-blur-sm px-3 py-2 pl-9 text-xs ring-offset-background placeholder:text-muted-foreground/50 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:border-primary disabled:cursor-not-allowed disabled:opacity-50 transition-all shadow-sm text-foreground"
                />
              </div>
            </div>

            <div class="space-y-1 relative group">
              <div class="flex items-center justify-between ml-1">
                <label for="password" class="text-[11px] font-medium text-muted-foreground">
                  Mot de passe
                </label>
                <a href="#" class="text-[11px] text-primary hover:text-primary/80 transition-colors">
                  Mot de passe oublié ?
                </a>
              </div>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted-foreground group-focus-within:text-primary transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  placeholder="••••••••"
                  class="flex h-10 w-full rounded-[var(--radius)] border border-border bg-card/50 backdrop-blur-sm px-3 py-2 pl-9 pr-9 text-xs ring-offset-background placeholder:text-muted-foreground/50 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary focus-visible:border-primary disabled:cursor-not-allowed disabled:opacity-50 transition-all shadow-sm text-foreground"
                />
                <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-3 flex items-center text-muted-foreground hover:text-primary transition-colors">
                  <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg id="eye-off-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 hidden">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="relative inline-flex items-center justify-center whitespace-nowrap rounded-[var(--radius)] text-[11px] font-bold ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 hover:shadow-[0_0_15px_rgba(225,193,110,0.3)] h-10 w-full mt-1 overflow-hidden uppercase tracking-wider"
          >
            <span class="btn-text">Connexion</span>
            <div class="loader-container hidden absolute inset-0 flex items-center justify-center bg-primary">
                <svg class="animate-spin h-5 w-5 text-primary-foreground" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
          </button>
        </form>
        
        <div id="message" role="alert" aria-live="polite" class="mt-1 text-center text-xs font-medium min-h-[16px]"></div>

        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <span class="w-full border-t border-border"></span>
          </div>
          <div class="relative flex justify-center text-[9px] uppercase tracking-wider">
            <span class="bg-background px-2 text-muted-foreground/60">Ou via</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <button
            type="button"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-[var(--radius)] text-[11px] font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-transparent hover:bg-card hover:text-foreground h-9 w-full gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            Apple
          </button>
          <button
            type="button"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-[var(--radius)] text-[11px] font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border bg-transparent hover:bg-card hover:text-foreground h-9 w-full gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/></svg>
            Google
          </button>
        </div>

        <p class="text-center text-[9px] text-muted-foreground/60 mt-2">
          En continuant, vous acceptez nos 
          <a href="#" class="underline underline-offset-4 hover:text-primary transition-colors">CGU</a> 
          et la 
          <a href="#" class="underline underline-offset-4 hover:text-primary transition-colors">Politique de confidentialité</a>.
        </p>
      </div>
    </div>
  </div>
</body>
</html>

<script>

    const form = document.querySelector("#login-form") as HTMLFormElement;
    const messageEl = document.querySelector("#message") as HTMLDivElement;
    const submitBtn = document.querySelector("#submit-btn") as HTMLButtonElement;
    const loader = document.querySelector(".loader-container") as HTMLDivElement;
    const btnText = document.querySelector(".btn-text") as HTMLSpanElement;

    const toggleBtn = document.querySelector("#toggle-password") as HTMLButtonElement;
    const passwordInput = document.querySelector("#password") as HTMLInputElement;
    const eyeIcon = document.querySelector("#eye-icon") as SVGElement;
    const eyeOffIcon = document.querySelector("#eye-off-icon") as SVGElement;

    toggleBtn?.addEventListener("click", () => {
        const isHidden = passwordInput.type === "password";
        passwordInput.type = isHidden ? "text" : "password";
        eyeIcon.classList.toggle("hidden", isHidden);
        eyeOffIcon.classList.toggle("hidden", !isHidden);
    });

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('reason') === 'inactivity' && messageEl) {
        messageEl.textContent = "Vous avez été déconnecté pour inactivité.";
        messageEl.className = "mt-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-center text-xs font-medium text-amber-500";
    }

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        // We let the form submit natively, but we can show the spinner
        submitBtn.disabled = true;
        loader.classList.remove("hidden");
        btnText.style.opacity = "0";
        messageEl.textContent = "Connexion en cours...";
        
        // Let the form submit naturally
        form.submit();
    });
</script>

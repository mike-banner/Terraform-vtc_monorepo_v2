---
// src/pages/booking-transfert.astro
import { Icon } from "astro-icon/components";
import BookingTransfertTunnel from "../../../components/booking/BookingTransfertTunnel.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const { tenant } = Astro.locals;
---

<BaseLayout title="Réservation Transfert">
  <div class="bg-zinc-50 min-h-screen">
    <div class="container mx-auto px-4 pt-12">
      <div class="flex flex-col lg:flex-row gap-12 items-start">

        <!-- BLOC GAUCHE : TITRE + FORMULAIRE -->
        <div class="w-full lg:w-2/3">
          <div class="mb-10">
            <span class="text-luxe-red font-black text-[12px] uppercase tracking-[0.4em] mb-2 block">Estimation immédiate</span>
            <h1 class="text-5xl lg:text-6xl font-black uppercase italic tracking-tighter text-black mb-1">Transfert</h1>
            <p class="text-zinc-500 font-medium text-sm uppercase tracking-wider whitespace-nowrap">
              Complétez les informations ci-dessous pour obtenir une estimation immédiate
            </p>
          </div>

          <BookingTransfertTunnel />
        </div>

        <!-- BLOC DROITE : INFORMATIONS / AVANTAGES -->
        <div class="w-full lg:w-1/3 space-y-8">
          <!-- Avantages Section -->
          <div class="bg-white p-8 border border-zinc-100 shadow-sm rounded-sm">
            <h4 class="text-[11px] font-black uppercase tracking-[0.3em] text-black mb-8 border-b border-zinc-200 pb-4">
              Vos Avantages Exclusifs
            </h4>
            <ul class="space-y-6">
              <li class="flex gap-4 items-start">
                <Icon name="ri:calendar-event-line" class="text-xl text-luxe-red shrink-0" />
                <div>
                  <span class="block text-xs font-bold uppercase mb-1">Annulation Flexible</span>
                  <p class="text-[13px] text-zinc-500 leading-relaxed italic">Gratuite jusqu'à 1 heure avant la prise en charge.</p>
                </div>
              </li>
              <li class="flex gap-4 items-start">
                <Icon name="ri:time-line" class="text-xl text-luxe-red shrink-0" />
                <div>
                  <span class="block text-xs font-bold uppercase mb-1">Attente Gratuite</span>
                  <p class="text-[13px] text-zinc-500 leading-relaxed italic">60 minutes d'attente offertes aux aéroports et gares.</p>
                </div>
              </li>
              <li class="flex gap-4 items-start">
                <Icon name="ri:service-line" class="text-xl text-luxe-red shrink-0" />
                <div>
                  <span class="block text-xs font-bold uppercase mb-1">Accueil Privilège</span>
                  <p class="text-[13px] text-zinc-500 leading-relaxed italic">Chauffeur en tenue avec pancarte nominative à l'arrivée (V-VIP).</p>
                </div>
              </li>
              <li class="flex gap-4 items-start">
                <Icon name="ri:cup-line" class="text-xl text-luxe-red shrink-0" />
                <div>
                  <span class="block text-xs font-bold uppercase mb-1">Confort & Rafraîchissement</span>
                  <p class="text-[13px] text-zinc-500 leading-relaxed italic">Bouteille d'eau, friandises et Wi-Fi à bord de nos véhicules.</p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Note de sécurité / Bagages -->
          <div class="bg-black p-8 text-white rounded-sm shadow-xl">
            <div class="flex items-center gap-3 mb-6">
              <Icon name="ri:error-warning-line" class="text-luxe-red text-2xl" />
              <h4 class="text-[11px] font-black uppercase tracking-[0.2em]">Notes Importantes</h4>
            </div>
            <div class="space-y-4 text-[12px] leading-relaxed font-light text-zinc-400 mb-6">
              <p>
                La capacité des invités et des bagages doit être respectée pour des raisons de sécurité.
              </p>
              <p>
                <span class="text-white font-bold">Conseil :</span> Nos chauffeurs se réservent le droit de refuser le service si la capacité autorisée est dépassée.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

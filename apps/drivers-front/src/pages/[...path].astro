---
// src/pages/[...path].astro
import { resolveSite } from "../router/siteResolver";

const host = Astro.url.host;
const site = resolveSite(host);
const path = Astro.params.path || "";

console.log(`[ROUTER] Request for host: ${host}, resolved site: ${site}, path: ${path}`);

const tenantData = Astro.locals.tenant;

// 1. Liste de tous les fichiers possibles pour ce site
const sitePages = import.meta.glob("../sites/*/pages/**/*.astro");
console.log(`[ROUTER] Glob found ${Object.keys(sitePages).length} files.`);
if (path === "home") {
    console.log(`[ROUTER] Debugging /home. Available keys:`, Object.keys(sitePages));
}

// 2. Chercher le fichier correspondant
// On essaie plusieurs combinaisons :
// - Chemin exact (ex: index, services)
// - Catch-all tunnels (si le chemin commence par tunnels/)
// - Index dans un sous-dossier

let targetFile = "";
let targetPath = path === "" ? "index" : path;

// Normalisation (suppression des slashs de fin et passage en minuscules)
targetPath = targetPath.replace(/\/$/, "").toLowerCase();

console.log(`[ROUTER] Target path normalized: ${targetPath}`);

// Cas spécifique des tunnels
if (targetPath.startsWith("tunnels/")) {
    targetFile = `../sites/${site}/pages/tunnels/[...slug].astro`;
} else {
    // Cas classique
    targetFile = `../sites/${site}/pages/${targetPath}.astro`;
}

console.log(`[ROUTER] Attempting to load: ${targetFile}`);

let Page;
if (sitePages[targetFile]) {
    const module = await sitePages[targetFile]();
    Page = (module as any).default;
    console.log(`[ROUTER] Page loaded successfully!`);
} else {
    console.warn(`[ROUTER] File not found in glob: ${targetFile}`);
    console.log(`[ROUTER] Available keys under sites:`, Object.keys(sitePages).filter(k => k.includes(site)));
    // Si pas trouvé, on peut essayer tunnels sans le catch-all si c'est juste /tunnels
    if (targetPath === "tunnels") {
        const fallback = `../sites/${site}/pages/tunnels/index.astro`;
        if (sitePages[fallback]) {
            const module = await sitePages[fallback]();
            Page = (module as any).default;
        }
    }
}
---

{Page ? (
  <Page />
) : (
  <main class="min-h-screen flex items-center justify-center bg-zinc-50 p-8 font-sans">
    <div class="max-w-md w-full text-center">
      <h1 class="text-9xl font-semibold text-zinc-200 tracking-tighter">404</h1>
      <p class="text-zinc-500 uppercase tracking-[0.2em] text-[10px] font-bold mt-4">Page introuvable chez {tenantData?.name || 'VTC HUB'}</p>
      <p class="text-[8px] text-zinc-300 mt-2">ID Site: {site} | Path: {path}</p>
      <a href="/" class="inline-block mt-12 px-10 py-4 bg-black text-white text-[11px] font-bold uppercase tracking-widest shadow-xl hover:bg-zinc-800 transition-all">Retour à l'accueil</a>
    </div>
  </main>
)}

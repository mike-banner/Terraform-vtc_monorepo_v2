---
// src/components/home/EventService.astro
import { Icon } from 'astro-icon/components';
---

<section class="py-24 bg-black relative overflow-hidden font-sans">
  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-16 lg:gap-24">

      <!-- Image Grid (Simplified) -->
      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-4">
          <img
            src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=2069&auto=format&fit=crop"
            alt="Corporate Event"
            class="w-full h-[300px] object-cover rounded-sm grayscale opacity-60 hover:opacity-100 transition-all duration-700"
          />
          <img
            src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=2070&auto=format&fit=crop"
            alt="Wedding"
            class="w-full h-[200px] object-cover rounded-sm grayscale opacity-60 hover:opacity-100 transition-all duration-700"
          />
        </div>
        <div class="flex flex-col gap-4 mt-8">
          <img
            src="https://images.unsplash.com/photo-1505373877841-8d25f7d46678?q=80&w=2012&auto=format&fit=crop"
            alt="Conference"
            class="w-full h-[200px] object-cover rounded-sm grayscale opacity-60 hover:opacity-100 transition-all duration-700"
          />
          <img
            src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=2070&auto=format&fit=crop"
            alt="Show"
            class="w-full h-[300px] object-cover rounded-sm grayscale opacity-60 hover:opacity-100 transition-all duration-700"
          />
        </div>
      </div>

      <!-- Text Section -->
      <div class="text-white">
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-accent mb-6 block">ÉVÈNEMENTIEL</span>
        <h3 class="text-3xl md:text-5xl font-semibold tracking-tight text-white leading-tight mb-8">
          Prestations d'exception <br/> <span class="text-zinc-500">pour vos événements</span>
        </h3>

        <div class="space-y-8 mb-12">
          <div class="flex gap-6 items-start group">
             <div class="w-12 h-12 shrink-0 rounded-full bg-white flex items-center justify-center text-black group-hover:bg-black group-hover:text-white border border-transparent hover:border-white/20 transition-all duration-300">
                <Icon name="ri:vip-diamond-line" class="text-xl" />
             </div>
             <div>
                <h4 class="text-lg font-semibold tracking-tight mb-2 text-white">Séminaires & Galas</h4>
                <p class="text-zinc-400 text-sm font-normal leading-relaxed">Une logistique irréprochable pour vos convives de prestige lors de vos événements corporate.</p>
             </div>
          </div>
          <div class="flex gap-6 items-start group">
             <div class="w-12 h-12 shrink-0 rounded-full bg-white flex items-center justify-center text-black group-hover:bg-black group-hover:text-white border border-transparent hover:border-white/20 transition-all duration-300">
                <Icon name="ri:shirt-line" class="text-xl" />
             </div>
             <div>
                <h4 class="text-lg font-semibold tracking-tight mb-2 text-white">Fashion Week & Showrooms</h4>
                <p class="text-zinc-400 text-sm font-normal leading-relaxed">Mise à disposition flexible pour accompagner vos invités d'un défilé à l'autre.</p>
             </div>
          </div>
        </div>

        <a
          href="/booking"
          class="inline-block bg-white text-black px-10 py-5 font-semibold uppercase tracking-widest text-[11px] hover:bg-black hover:text-white border border-transparent hover:border-white/20 transition-all shadow-xl active:scale-95"
        >
          Devis Événementiel →
        </a>
      </div>

    </div>
  </div>
</section>

---
// src/components/conception/BerlineBusiness.astro
---

<div class='flex flex-col lg:flex-row items-center gap-24'>
  <div class='lg:w-1/2 relative'>
    <img
      class='rounded-none shadow-2xl relative z-10 w-full h-[500px] object-cover grayscale brightness-90'
      src='https://lh3.googleusercontent.com/aida-public/AB6AXuDvTCxrUvtsjhENmdFazHWy_LuY-6JE2CUKRhrHtWlgdThX4DRG98zgrmuUZSA_23Ap8G4GlSE6upztah7WaU6DgRSgJhJXlLGpiC3d0tHovIC99MQOc4-FnTHlcqEuzgyu-a1oiV_dqwV763RFmIkqrtGzn6BYKBGUS7jon3_Xtk1CNri_h2gxQXLSFyRuqsLGlKU57GdHze4rNaEue_b9lYSpaIhwCkoAKeT34u405RPvfP3gPMOqV9kl_2g0Gq4nTkRSl2JX2RXf'
      alt='Mercedes S-Class'
    />
    <div
      class='absolute -bottom-8 -right-8 bg-black p-8 rounded-none shadow-2xl z-20 border-t-2 border-elite-accent'>
      <p class='font-headline font-bold text-white text-2xl uppercase tracking-tighter'>Classe S</p>
      <p class='text-[9px] font-label text-elite-accent uppercase tracking-[0.3em] font-bold mt-2'>
        Executive Luxury
      </p>
    </div>
  </div>
  <div class='lg:w-1/2 text-left'>
    <span class='text-elite-accent font-label font-bold tracking-[0.3em] uppercase text-[10px]'
      >Pure Elegance</span
    >
    <h2
      class='text-black font-headline text-4xl md:text-6xl font-extrabold tracking-tighter mt-4 mb-8 uppercase'>
      Berline<br />Business
    </h2>
    <p class='text-black/50 text-base leading-relaxed mb-10 max-w-md'>
      Le summum du confort automobile pour vos transferts de direction et missions protocolaires.
    </p>
    <div
      class='grid grid-cols-2 gap-8 font-bold text-[10px] uppercase tracking-widest text-black/80'>
      <div class='flex items-center gap-3'>
        <span class='material-symbols-outlined text-elite-accent text-sm'>check</span> 3 Passagers
      </div>
      <div class='flex items-center gap-3'>
        <span class='material-symbols-outlined text-elite-accent text-sm'>check</span> Wi-Fi 5G
      </div>
    </div>
  </div>
</div>

---
// src/components/tunnels/AvailabilityTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';

const availabilityOptions = [
  {
    id: 'halfDay',
    name: 'Demi-journée',
    duration: '4 heures',
    price: 'À partir de 260€',
    desc: 'Idéal pour rendez-vous courts',
  },
  {
    id: 'fullDay',
    name: 'Journée complète',
    duration: '8 heures',
    price: 'À partir de 450€',
    desc: 'Service 8h avec pauses incluses',
  },
  {
    id: 'extended',
    name: 'Journée étendue',
    duration: '12 heures',
    price: 'À partir de 650€',
    desc: 'Pour journées marathon',
  },
];

const useCases = [
  {
    id: 'shopping',
    name: 'Shopping & Visites',
    icon: 'ri:shopping-bag-line',
    desc: 'Accompagnement shopping et visites touristiques',
  },
  {
    id: 'events',
    name: 'Événements',
    icon: 'ri:calendar-event-line',
    desc: 'Transport pour mariages, galas, cérémonies',
  },
  {
    id: 'medical',
    name: 'Accompagnement médical',
    icon: 'ri:hospital-line',
    desc: 'Rendez-vous médicaux et hospitaliers',
  },
  {
    id: 'family',
    name: 'Transport familial',
    icon: 'ri:team-line',
    desc: 'Déplacements en famille avec enfants',
  },
  {
    id: 'airport',
    name: 'Transferts multiples',
    icon: 'ri:plane-line',
    desc: 'Plusieurs allers-retours aéroport',
  },
  {
    id: 'custom',
    name: 'Usage personnalisé',
    icon: 'ri:user-star-line',
    desc: 'Besoins spécifiques sur mesure',
  },
];

const { ...props } = Astro.props;
---

<TunnelLayout currentStep={1} totalSteps={4} serviceType='availability' {...props}>
  <form id='tunnel-form' class='max-w-4xl mx-auto'>
    <!-- Étape 1: Durée de disponibilité -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Durée de disponibilité</h2>
      <p class='text-zinc-600 mb-8'>
        Choisissez la durée pendant laquelle vous souhaitez un chauffeur à votre disposition
      </p>

      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        {
          availabilityOptions.map((option) => (
            <label class='relative group cursor-pointer'>
              <input type='radio' name='duration' value={option.id} class='sr-only peer' />
              <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-orange-500 transition-all duration-300 peer-checked:border-orange-500 peer-checked:bg-orange-500/5 h-full'>
                <div class='w-12 h-12 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-orange-500/10 transition-colors'>
                  <Icon
                    name='ri:time-line'
                    class='text-xl text-zinc-600 group-hover:text-orange-500'
                  />
                </div>
                <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{option.name}</h3>
                <div class='text-sm font-medium text-orange-500 mb-2'>{option.duration}</div>
                <p class='text-sm text-zinc-600 mb-4'>{option.desc}</p>
                <div class='text-lg font-bold text-orange-500 mt-4'>{option.price}</div>
              </div>
              <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-orange-500 peer-checked:bg-orange-500 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                <Icon name='ri:check-line' class='text-white text-xs' />
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Étape 2: Type d'utilisation -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Type d'utilisation</h2>
      <p class='text-zinc-600 mb-8'>
        Sélectionnez le type d'utilisation prévue pour mieux adapter notre service
      </p>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'>
        {
          useCases.map((useCase) => (
            <label class='relative group cursor-pointer'>
              <input type='radio' name='useCase' value={useCase.id} class='sr-only peer' />
              <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-orange-500 transition-all duration-300 peer-checked:border-orange-500 peer-checked:bg-orange-500/5 h-full'>
                <div class='w-10 h-10 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-orange-500/10 transition-colors'>
                  <Icon
                    name={useCase.icon}
                    class='text-lg text-zinc-600 group-hover:text-orange-500'
                  />
                </div>
                <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{useCase.name}</h3>
                <p class='text-sm text-zinc-600'>{useCase.desc}</p>
              </div>
              <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-orange-500 peer-checked:bg-orange-500 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                <Icon name='ri:check-line' class='text-white text-xs' />
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Étape 3: Date et horaires -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Date et horaires</h2>
      <p class='text-zinc-600 mb-8'>Définissez la date et les horaires de votre service</p>

      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Date du service</label>
          <input
            type='date'
            name='serviceDate'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'
            required
          />
        </div>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Heure de début</label>
          <input
            type='time'
            name='startTime'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'
            required
          />
        </div>
      </div>

      <div class='mt-6'>
        <label class='block text-sm font-medium text-zinc-700 mb-2'
          >Zone de prise en charge initiale</label
        >
        <input
          type='text'
          name='initialPickup'
          placeholder='Ex: Hôtel, domicile, gare...'
          class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'
          required
        />
      </div>

      <div class='mt-6'>
        <label class='flex items-center gap-3 cursor-pointer'>
          <input
            type='checkbox'
            name='flexibleHours'
            class='w-5 h-5 text-orange-500 rounded focus:ring-orange-500'
          />
          <span class='text-sm text-zinc-700'
            >Horaires flexibles (le chauffeur s'adapte à votre emploi du temps)</span
          >
        </label>
      </div>
    </div>

    <!-- Étape 4: Détails et préférences -->
    <div>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Détails et préférences</h2>
      <p class='text-zinc-600 mb-8'>Personnalisez votre service selon vos besoins spécifiques</p>

      <div class='space-y-6'>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Nombre de passagers</label>
          <select
            name='passengerCount'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'
            required>
            <option value='1'>1 passager</option>
            <option value='2'>2 passagers</option>
            <option value='3'>3 passagers</option>
            <option value='4'>4 passagers</option>
            <option value='5'>5 passagers</option>
            <option value='6'>6 passagers</option>
          </select>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Type de véhicule préféré</label
          >
          <select
            name='vehiclePreference'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'>
            <option value=''>Aucune préférence</option>
            <option value='sedan'>Berline Premium</option>
            <option value='suv'>SUV Confort</option>
            <option value='van'>Van Espace</option>
            <option value='electric'>Véhicule électrique</option>
          </select>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Langues parlées souhaitées (optionnel)</label
          >
          <div class='flex flex-wrap gap-2 mt-2'>
            {
              ['Français', 'Anglais', 'Espagnol', 'Allemand', 'Italien', 'Arabe', 'Chinois'].map(
                (lang) => (
                  <label class='flex items-center gap-2 cursor-pointer'>
                    <input
                      type='checkbox'
                      name='languages'
                      value={lang}
                      class='w-4 h-4 text-orange-500 rounded focus:ring-orange-500'
                    />
                    <span class='text-sm text-zinc-700'>{lang}</span>
                  </label>
                ),
              )
            }
          </div>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Équipements spéciaux nécessaires (optionnel)</label
          >
          <div class='flex flex-wrap gap-2 mt-2'>
            {
              [
                'Siège bébé',
                'Siège enfant',
                'Rampes PMR',
                'Espace bagages',
                'WiFi',
                'Chargeur USB',
                'Eau minérale',
                'Journal',
              ].map((equipment) => (
                <label class='flex items-center gap-2 cursor-pointer'>
                  <input
                    type='checkbox'
                    name='equipment'
                    value={equipment}
                    class='w-4 h-4 text-orange-500 rounded focus:ring-orange-500'
                  />
                  <span class='text-sm text-zinc-700'>{equipment}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Itinéraire prévisionnel (optionnel)</label
          >
          <textarea
            name='plannedItinerary'
            rows='3'
            placeholder='Ex: 1. Hôtel → Centre commercial 2. Centre commercial → Restaurant 3. Restaurant → Aéroport'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'
          ></textarea>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Notes spéciales (optionnel)</label
          >
          <textarea
            name='specialNotes'
            rows='3'
            placeholder='Ex: Personne à mobilité réduite, anniversaire surprise, besoins médicaux...'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent'
          ></textarea>
        </div>
      </div>
    </div>
  </form>
</TunnelLayout>

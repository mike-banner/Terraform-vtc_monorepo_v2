---
// src/components/tunnels/AirportTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';

const airports = [
  { code: 'CDG', name: 'Paris Charles de Gaulle', distance: '4h30' },
  { code: 'ORY', name: 'Paris Orly', distance: '4h15' },
  { code: 'LYS', name: 'Lyon Saint-Exupéry', distance: '30min' },
  { code: 'GVA', name: 'Genève Aéroport', distance: '2h' },
  { code: 'MRS', name: 'Marseille Provence', distance: '3h' },
  { code: 'NCE', name: "Nice Côte d'Azur", distance: '4h30' },
];

const vehicleTypes = [
  {
    type: 'standard',
    name: 'Berline Premium',
    seats: 3,
    price: 'À partir de 85€',
    icon: 'ri:car-line',
  },
  {
    type: 'business',
    name: 'Classe Affaires',
    seats: 3,
    price: 'À partir de 110€',
    icon: 'ri:briefcase-line',
  },
  { type: 'van', name: 'Van VIP', seats: 6, price: 'À partir de 150€', icon: 'ri:bus-2-line' },
];

const { serviceType = 'airport', ...props } = Astro.props;
const isGeneralTransfer = serviceType === 'transfert';

const destinations = isGeneralTransfer
  ? [
      { code: 'LYS', name: 'Aéroport Lyon Saint-Exupéry', distance: '30min' },
      { code: 'PART-DIEU', name: 'Gare Lyon Part-Dieu', distance: '15min' },
      { code: 'PERRACHE', name: 'Gare Lyon Perrache', distance: '10min' },
      { code: 'GVA', name: 'Aéroport de Genève', distance: '2h' },
      { code: 'COURCHEVEL', name: 'Station Courchevel / Alpes', distance: '2h15' },
      { code: 'CDG', name: 'Aéroport Paris CDG', distance: '4h30' },
    ]
  : airports;
---

<TunnelLayout currentStep={1} totalSteps={4} serviceType={serviceType} {...props}>
  <form id='tunnel-form' class='max-w-4xl mx-auto'>
    <!-- Étape 1: Sélection transfert/aéroport -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>
        {isGeneralTransfer ? 'Sélectionnez votre transfert' : 'Sélectionnez votre aéroport'}
      </h2>
      <p class='text-zinc-600 mb-8'>
        {isGeneralTransfer ? 'Choisissez votre transfert de départ ou d\'arrivée' : 'Choisissez votre aéroport de départ ou d\'arrivée'}
      </p>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'>
        {
          destinations.map((dest) => (
            <label class='relative group cursor-pointer'>
              <input type='radio' name='airport' value={dest.code} class='sr-only peer' />
              <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-accent transition-all duration-300 peer-checked:border-accent peer-checked:bg-accent/5'>
                <div class='flex items-start justify-between mb-4'>
                  <div>
                    <div class='text-lg font-semibold text-zinc-900'>{dest.code}</div>
                    <div class='text-sm text-zinc-600 mt-1'>{dest.name}</div>
                  </div>
                  <div class='text-xs font-medium text-accent bg-accent/10 px-2 py-1 rounded'>
                    {dest.distance}
                  </div>
                </div>
                <div class='flex items-center gap-2 text-sm text-zinc-500'>
                  <Icon name='ri:map-pin-line' class='text-sm' />
                  <span>Transfert depuis Lyon</span>
                </div>
              </div>
              <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-accent peer-checked:bg-accent flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                <Icon name='ri:check-line' class='text-white text-xs' />
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Étape 2: Type de véhicule -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Choisissez votre véhicule</h2>
      <p class='text-zinc-600 mb-8'>Sélectionnez le type de véhicule adapté à vos besoins</p>

      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        {
          vehicleTypes.map((vehicle) => (
            <label class='relative group cursor-pointer'>
              <input type='radio' name='vehicle' value={vehicle.type} class='sr-only peer' />
              <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-accent transition-all duration-300 peer-checked:border-accent peer-checked:bg-accent/5 h-full'>
                <div class='w-12 h-12 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-accent/10 transition-colors'>
                  <Icon name={vehicle.icon} class='text-xl text-zinc-600 group-hover:text-accent' />
                </div>
                <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{vehicle.name}</h3>
                <div class='space-y-2 mb-4'>
                  <div class='flex items-center gap-2 text-sm text-zinc-600'>
                    <Icon name='ri:user-line' class='text-sm' />
                    <span>{vehicle.seats} passagers maximum</span>
                  </div>
                  <div class='flex items-center gap-2 text-sm text-zinc-600'>
                    <Icon name='ri:suitcase-line' class='text-sm' />
                    <span>Bagages inclus</span>
                  </div>
                </div>
                <div class='text-lg font-bold text-accent mt-4'>{vehicle.price}</div>
              </div>
              <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-accent peer-checked:bg-accent flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                <Icon name='ri:check-line' class='text-white text-xs' />
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Étape 3: Date et heure -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Date et heure du transfert</h2>
      <p class='text-zinc-600 mb-8'>Précisez la date et l'heure de votre trajet</p>

      <div class='grid grid-cols-2 gap-4 max-w-md'>
        <div>
          <label class='block text-xs font-semibold text-zinc-700 mb-1.5'>Date du trajet</label>
          <input
            type='text'
            name='date'
            id='flatpickr-date'
            placeholder='Choisir la date'
            class='w-full px-3 py-2.5 text-sm border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent bg-white text-zinc-900 cursor-pointer'
            required
          />
        </div>
        <div>
          <label class='block text-xs font-semibold text-zinc-700 mb-1.5'>Heure du trajet</label>
          <input
            type='text'
            name='time'
            id='flatpickr-time'
            placeholder='Choisir l\'heure'
            class='w-full px-3 py-2.5 text-sm border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent bg-white text-zinc-900 cursor-pointer'
            required
          />
        </div>
      </div>

      <div class='mt-6'>
        <label class='flex items-center gap-3 cursor-pointer'>
          <input
            type='checkbox'
            name='flightTracking'
            class='w-5 h-5 text-accent rounded focus:ring-accent'
          />
          <span class='text-sm text-zinc-700'
            >Activer le suivi de vol (nous ajustons l'heure en fonction des retards)</span
          >
        </label>
      </div>
    </div>

    <!-- Étape 4: Adresses -->
    <div>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>
        Adresses de prise en charge et destination
      </h2>
      <p class='text-zinc-600 mb-8'>Indiquez les adresses exactes de votre trajet</p>

      <div class='space-y-6'>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Adresse de départ</label>
          <input
            type='text'
            name='pickupAddress'
            placeholder='Ex: 1 Place Bellecour, Lyon'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent'
            required
          />
        </div>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Adresse d'arrivée</label>
          <input
            type='text'
            name='dropoffAddress'
            placeholder='Ex: Terminal 2, Aéroport CDG'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent'
            required
          />
        </div>
      </div>
    </div>
  </form>
</TunnelLayout>

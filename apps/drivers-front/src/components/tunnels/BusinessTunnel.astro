---
// src/components/tunnels/BusinessTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';

const businessPackages = [
  {
    id: 'hourly',
    name: "À l'heure",
    desc: 'Chauffeur à disposition par heure',
    price: '65€/h',
    minHours: 3,
  },
  {
    id: 'daily',
    name: 'À la journée',
    desc: 'Chauffeur à disposition 8h/jour',
    price: '450€/jour',
    features: ['8h incluses', 'Péages inclus'],
  },
  {
    id: 'monthly',
    name: 'Forfait mensuel',
    desc: 'Solution complète pour vos équipes',
    price: 'Sur devis',
    features: ['Véhicule dédié', 'Chauffeur attitré'],
  },
];

const vehicleOptions = [
  {
    type: 'executive',
    name: 'Berline Executive',
    icon: 'ri:car-line',
    capacity: '3 passagers',
    features: ['WiFi', 'Eau minérale', 'Journal'],
  },
  {
    type: 'suv',
    name: 'SUV Premium',
    icon: 'ri:caravan-line',
    capacity: '5 passagers',
    features: ['Espace bagages', 'Confort supérieur'],
  },
  {
    type: 'van',
    name: 'Van Corporate',
    icon: 'ri:bus-2-line',
    capacity: '7 passagers',
    features: ['Tablettes', 'Prise USB', 'Espace réunion'],
  },
];

const { ...props } = Astro.props;
---

<TunnelLayout currentStep={1} totalSteps={4} serviceType='business' {...props}>
  <form id='tunnel-form' class='max-w-4xl mx-auto'>
    <!-- Étape 1: Type de forfait -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Forfait professionnel</h2>
      <p class='text-zinc-600 mb-8'>Choisissez la formule adaptée à vos besoins d'affaires</p>

      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        {
          businessPackages.map((pkg) => (
            <label class='relative group cursor-pointer'>
              <input type='radio' name='package' value={pkg.id} class='sr-only peer' />
              <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-purple-500 transition-all duration-300 peer-checked:border-purple-500 peer-checked:bg-purple-500/5 h-full'>
                <div class='w-12 h-12 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-purple-500/10 transition-colors'>
                  <Icon
                    name='ri:briefcase-line'
                    class='text-xl text-zinc-600 group-hover:text-purple-500'
                  />
                </div>
                <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{pkg.name}</h3>
                <p class='text-sm text-zinc-600 mb-4'>{pkg.desc}</p>

                {pkg.features && (
                  <ul class='space-y-2 mb-4'>
                    {pkg.features.map((feature, idx) => (
                      <li class='flex items-center gap-2 text-sm text-zinc-600'>
                        <Icon name='ri:check-line' class='text-green-500 text-sm' />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {pkg.minHours && (
                  <div class='text-sm text-zinc-500 mb-4'>Minimum: {pkg.minHours}h</div>
                )}

                <div class='text-lg font-bold text-purple-500 mt-4'>{pkg.price}</div>
              </div>
              <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-purple-500 peer-checked:bg-purple-500 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                <Icon name='ri:check-line' class='text-white text-xs' />
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Étape 2: Véhicule -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Sélection du véhicule</h2>
      <p class='text-zinc-600 mb-8'>
        Choisissez le véhicule adapté à vos déplacements professionnels
      </p>

      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        {
          vehicleOptions.map((vehicle) => (
            <label class='relative group cursor-pointer'>
              <input type='radio' name='vehicle' value={vehicle.type} class='sr-only peer' />
              <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-purple-500 transition-all duration-300 peer-checked:border-purple-500 peer-checked:bg-purple-500/5 h-full'>
                <div class='w-12 h-12 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-purple-500/10 transition-colors'>
                  <Icon
                    name={vehicle.icon}
                    class='text-xl text-zinc-600 group-hover:text-purple-500'
                  />
                </div>
                <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{vehicle.name}</h3>
                <div class='text-sm text-zinc-600 mb-4'>{vehicle.capacity}</div>

                <ul class='space-y-2 mb-4'>
                  {vehicle.features.map((feature, idx) => (
                    <li class='flex items-center gap-2 text-sm text-zinc-600'>
                      <Icon name='ri:check-line' class='text-green-500 text-sm' />
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-purple-500 peer-checked:bg-purple-500 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                <Icon name='ri:check-line' class='text-white text-xs' />
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <!-- Étape 3: Planning -->
    <div class='mb-12'>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Planning et horaires</h2>
      <p class='text-zinc-600 mb-8'>Définissez les créneaux horaires de votre service</p>

      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Date de début</label>
          <input
            type='date'
            name='startDate'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
            required
          />
        </div>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Heure de début quotidienne</label
          >
          <input
            type='time'
            name='dailyStartTime'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
            required
          />
        </div>
      </div>

      <div class='mt-6'>
        <label class='block text-sm font-medium text-zinc-700 mb-2'
          >Durée du service (heures par jour)</label
        >
        <select
          name='dailyHours'
          class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
          required>
          <option value='4'>4 heures</option>
          <option value='6'>6 heures</option>
          <option value='8'>8 heures</option>
          <option value='10'>10 heures</option>
          <option value='12'>12 heures</option>
        </select>
      </div>

      <div class='mt-6'>
        <label class='block text-sm font-medium text-zinc-700 mb-2'>Nombre de jours</label>
        <select
          name='numberOfDays'
          class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
          required>
          <option value='1'>1 jour</option>
          <option value='2'>2 jours</option>
          <option value='3'>3 jours</option>
          <option value='5'>5 jours (semaine)</option>
          <option value='7'>7 jours</option>
          <option value='custom'>Personnalisé</option>
        </select>
      </div>
    </div>

    <!-- Étape 4: Informations entreprise -->
    <div>
      <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Informations entreprise</h2>
      <p class='text-zinc-600 mb-8'>Renseignez les informations de votre société</p>

      <div class='space-y-6'>
        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Nom de l'entreprise</label>
          <input
            type='text'
            name='companyName'
            placeholder='Ex: Société Example SAS'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
            required
          />
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>SIRET</label>
            <input
              type='text'
              name='siret'
              placeholder='Ex: 123 456 789 00012'
              class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
            />
          </div>
          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'
              >TVA Intracommunautaire</label
            >
            <input
              type='text'
              name='vatNumber'
              placeholder='Ex: FR12345678901'
              class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
            />
          </div>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Adresse de facturation</label>
          <textarea
            name='billingAddress'
            rows='3'
            placeholder='Adresse complète de facturation'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
            required></textarea>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Zones de déplacement principales</label
          >
          <textarea
            name='serviceAreas'
            rows='3'
            placeholder='Ex: Centre-ville de Lyon, Aéroport, Siège social à Villeurbanne...'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
          ></textarea>
        </div>

        <div>
          <label class='block text-sm font-medium text-zinc-700 mb-2'
            >Notes spéciales (optionnel)</label
          >
          <textarea
            name='specialNotes'
            rows='3'
            placeholder='Ex: Besoins spécifiques, sécurité particulière, protocoles...'
            class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'
          ></textarea>
        </div>
      </div>
    </div>
  </form>
</TunnelLayout>

---
// src/components/tunnels/BusinessTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';
import InlineError from '../ui/InlineError.astro';
import { supabase } from '../../core/supabase';

const { tenant } = Astro.locals;
const tenantId = tenant?.id || "";

// Récupération des données
const [
  { data: vehiclesData },
  { data: pricingRulesData }
] = await Promise.all([
  supabase.rpc('get_available_vehicles', { p_tenant_id: tenantId }),
  supabase.from('pricing_rules').select('*').eq('tenant_id', tenantId).eq('active', true)
]);

const availableVehicles = vehiclesData || [];
const pricingRules = pricingRulesData || [];

const vehicleTypes = availableVehicles.map((v: any) => ({
  type: v.category,
  id: v.id,
  name: `${v.brand} ${v.model}`,
  seats: v.capacity,
  price: 'Calcul en cours...', // Modifié par JS
  icon: v.category.toLowerCase().includes('van') ? 'ri:bus-2-line' : (v.category.toLowerCase().includes('business') ? 'ri:briefcase-line' : 'ri:car-line')
}));

const businessPackages = [
  { id: 'hourly', name: "À l'heure", desc: 'Chauffeur à disposition par heure', price: 'Sur devis', minHours: 3 },
  { id: 'daily', name: 'À la journée', desc: 'Chauffeur à disposition 8h/jour', price: 'Sur devis', features: ['8h incluses', 'Disponibilité totale'] },
  { id: 'monthly', name: 'Forfait mensuel', desc: 'Solution complète pour vos équipes', price: 'Sur devis', features: ['Véhicule dédié', 'Chauffeur attitré'] },
];

const { ...props } = Astro.props;
---

<TunnelLayout currentStep={1} totalSteps={4} serviceType='business' {...props}>
  <div id="tunnel-data" data-tenant-id={tenantId} data-pricing={JSON.stringify(pricingRules)} class="hidden"></div>
  <form id='tunnel-form' class='max-w-4xl mx-auto' novalidate>
    
    <!-- Étape 1: Forfait -->
    <div class='step-container' data-step='1'>
      <div class='mb-12'>
        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Forfait professionnel</h2>
        <p class='text-zinc-600 mb-8'>Choisissez la formule adaptée à vos besoins (Salons, RDV d'affaires, événements)</p>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-8'>
          {
            businessPackages.map((pkg) => (
              <label class='relative group cursor-pointer'>
                <input type='radio' name='packageType' value={pkg.id} class='sr-only peer' required />
                <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-purple-500 transition-all duration-300 peer-checked:border-purple-500 peer-checked:bg-purple-500/5 h-full'>
                  <div class='w-12 h-12 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-purple-500/10 transition-colors'>
                    <Icon name='ri:briefcase-line' class='text-xl text-zinc-600 group-hover:text-purple-500' />
                  </div>
                  <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{pkg.name}</h3>
                  <p class='text-sm text-zinc-600 mb-4'>{pkg.desc}</p>
                  
                  {pkg.features && (
                    <ul class='space-y-2 mb-4'>
                      {pkg.features.map((feature) => (
                        <li class='flex items-center gap-2 text-sm text-zinc-600'>
                          <Icon name='ri:check-line' class='text-green-500 text-sm' />
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {pkg.minHours && <div class='text-sm text-zinc-500 mb-4'>Minimum: {pkg.minHours}h</div>}
                </div>
                <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-purple-500 peer-checked:bg-purple-500 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                  <Icon name='ri:check-line' class='text-white text-xs' />
                </div>
              </label>
            ))
          }
        </div>

        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Planning d'intervention</h2>
        <p class='text-zinc-600 mb-8'>Définissez les créneaux horaires de votre service</p>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-6 mb-6'>
          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Date de début</label>
            <input type='date' name='startDate' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
          </div>
          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Heure de début quotidienne</label>
            <input type='time' name='startTime' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
          </div>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <div id="hoursContainer">
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Durée quotidienne (en heures)</label>
            <input type='number' name='dailyHours' id='dailyHours' min='3' max='24' value='4' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
          </div>
          <div id="daysContainer">
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Nombre de jours (Si Forfait Journée)</label>
            <input type='number' name='numberOfDays' id='numberOfDays' min='1' max='30' value='1' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
          </div>
        </div>
      </div>
    </div>

    <!-- Étape 2: Véhicule -->
    <div class='step-container hidden' data-step='2'>
      <div class='mb-12'>
        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Sélection du véhicule</h2>
        <p class='text-zinc-600 mb-8'>Choisissez le véhicule adapté à vos déplacements professionnels</p>
        <p id="estimationNote" class="text-xs text-amber-600 font-medium mb-6 bg-amber-50 p-3 rounded-lg hidden">
          Le prix est "Sur devis" pour les forfaits mensuels.
        </p>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
          {
            vehicleTypes.map((vehicle: any) => (
              <label class='relative group cursor-pointer'>
                <input type='radio' name='vehicle' value={vehicle.type} data-id={vehicle.id} class='sr-only peer' required />
                <div class='p-6 border-2 border-zinc-200 rounded-xl hover:border-purple-500 transition-all duration-300 peer-checked:border-purple-500 peer-checked:bg-purple-500/5 h-full'>
                  <div class='w-12 h-12 rounded-lg bg-zinc-100 flex items-center justify-center mb-4 group-hover:bg-purple-500/10 transition-colors'>
                    <Icon name={vehicle.icon} class='text-xl text-zinc-600 group-hover:text-purple-500' />
                  </div>
                  <h3 class='text-lg font-semibold text-zinc-900 mb-2'>{vehicle.name}</h3>
                  <div class='space-y-2 mb-4'>
                    <div class='flex items-center gap-2 text-sm text-zinc-600'>
                      <Icon name='ri:user-line' class='text-sm' />
                      <span>{vehicle.seats} passagers</span>
                    </div>
                  </div>
                  <div class='text-lg font-bold text-purple-500 mt-4 price-display'>{vehicle.price}</div>
                </div>
                <div class='absolute top-4 right-4 w-6 h-6 border-2 border-zinc-300 rounded-full peer-checked:border-purple-500 peer-checked:bg-purple-500 flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                  <Icon name='ri:check-line' class='text-white text-xs' />
                </div>
              </label>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Étape 3: Lieu d'attente -->
    <div class='step-container hidden' data-step='3'>
      <div class='mb-12'>
        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Lieu de l'événement</h2>
        <p class='text-zinc-600 mb-8'>Indiquez le point fixe principal où le chauffeur sera à votre disposition</p>

        <div class='space-y-6'>
          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Adresse principale d'attente (Requis)</label>
            <input type='text' name='mainLocation' placeholder='Ex: Eurexpo Lyon, Centre de Congrès, Siège social...' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
          </div>

          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Nom de l'événement / Salon (Optionnel)</label>
            <input type='text' name='eventName' placeholder="Ex: Salon de l'Agriculture, Réunion Annuelle..." class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' />
          </div>

          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Notes spéciales & Besoins en sécurité (Optionnel)</label>
            <textarea name='specialNotes' rows='3' placeholder='Ex: VIP, accès spécifique, badge fourni sur place...' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent'></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Étape 4: Informations entreprise -->
    <div class='step-container hidden' data-step='4'>
      <div class='mt-12'>
        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Informations entreprise</h2>
        <p class='text-zinc-600 mb-8'>Renseignez les informations de facturation de votre société</p>

        <div class='space-y-6'>
          <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
            <div>
              <label class='block text-sm font-medium text-zinc-700 mb-2'>Prénom du contact</label>
              <input type='text' name='contactFirstName' placeholder='Prénom' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
            </div>
            <div>
              <label class='block text-sm font-medium text-zinc-700 mb-2'>Nom du contact</label>
              <input type='text' name='contactLastName' placeholder='Nom' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
            </div>
          </div>
          
          <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
            <div>
              <label class='block text-sm font-medium text-zinc-700 mb-2'>Email professionnel</label>
              <input type='email' name='email' placeholder='votre@entreprise.com' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
            </div>
            <div>
              <label class='block text-sm font-medium text-zinc-700 mb-2'>Téléphone</label>
              <input type='tel' name='phone' placeholder='+33 6 00 00 00 00' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
            </div>
          </div>

          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Nom de l'entreprise</label>
            <input type='text' name='companyName' placeholder='Ex: Société Example SAS' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required />
          </div>

          <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
            <div>
              <label class='block text-sm font-medium text-zinc-700 mb-2'>SIRET</label>
              <input type='text' name='siret' placeholder='Ex: 123 456 789 00012' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' />
            </div>
            <div>
              <label class='block text-sm font-medium text-zinc-700 mb-2'>TVA Intracommunautaire</label>
              <input type='text' name='vatNumber' placeholder='Ex: FR12345678901' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' />
            </div>
          </div>

          <div>
            <label class='block text-sm font-medium text-zinc-700 mb-2'>Adresse de facturation</label>
            <textarea name='billingAddress' rows='2' placeholder='Adresse complète de facturation' class='w-full px-4 py-3 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent' required></textarea>
          </div>
        </div>
      </div>
    </div>
  </form>
</TunnelLayout>

<script>
  function initTunnel() {
    const dataDiv = document.getElementById('tunnel-data');
    if (!dataDiv) return;

    const pricingRules = JSON.parse(dataDiv.dataset.pricing || '[]');
    const form = document.getElementById('tunnel-form') as HTMLFormElement;
    if (!form) return;

    const vehicleInputs = document.querySelectorAll('input[name="vehicle"]');
    const packageInputs = document.querySelectorAll('input[name="packageType"]');
    const dailyHoursInput = document.getElementById('dailyHours') as HTMLInputElement;
    const numberOfDaysInput = document.getElementById('numberOfDays') as HTMLInputElement;
    const hoursContainer = document.getElementById('hoursContainer');
    const daysContainer = document.getElementById('daysContainer');
    const estimationNote = document.getElementById('estimationNote');

    let currentStep = 1;
    const maxSteps = 4;
    const steps = document.querySelectorAll('.step-container');
    const submitBtn = document.querySelector('button[form="tunnel-form"]') as HTMLButtonElement;
    const backBtn = document.getElementById('back-btn');
    
    // Logique d'affichage des champs horaires/jours
    packageInputs.forEach(radio => {
      radio.addEventListener('change', () => {
        const val = (radio as HTMLInputElement).value;
        if (val === 'hourly') {
          hoursContainer?.classList.remove('hidden');
          daysContainer?.classList.add('hidden');
        } else if (val === 'daily') {
          hoursContainer?.classList.add('hidden');
          daysContainer?.classList.remove('hidden');
        } else if (val === 'monthly') {
          hoursContainer?.classList.add('hidden');
          daysContainer?.classList.add('hidden');
        }
      });
    });

    // Initialiser au cas où
    const defaultPackage = Array.from(packageInputs).find(r => (r as HTMLInputElement).checked) as HTMLInputElement;
    if (defaultPackage?.value === 'hourly') { daysContainer?.classList.add('hidden'); }
    else if (defaultPackage?.value === 'daily') { hoursContainer?.classList.add('hidden'); }

    function showStep(stepIndex: number) {
      steps.forEach((el, idx) => {
        if (idx + 1 === stepIndex) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
      
      if (stepIndex === 2) updatePriceDisplay();
      
      const progressBar = document.getElementById('progress-bar-line');
      if (progressBar) progressBar.style.width = `${((stepIndex - 1) / (maxSteps - 1)) * 100}%`;
      
      const circles = document.querySelectorAll('.progress-step-circle');
      circles.forEach(circle => {
        const stepNum = parseInt(circle.getAttribute('data-step') || '1', 10);
        circle.className = `progress-step-circle w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300 ${
          stepNum < stepIndex ? 'bg-black text-white' : stepNum === stepIndex ? 'bg-black text-white ring-4 ring-black/5' : 'bg-zinc-200 text-zinc-500'
        }`;
      });
      const labels = document.querySelectorAll('.progress-step-label');
      labels.forEach(label => {
        const stepNum = parseInt(label.getAttribute('data-step') || '1', 10);
        label.className = `progress-step-label mt-2 text-xs font-medium text-center transition-colors duration-300 ${
          stepNum <= stepIndex ? 'text-zinc-900' : 'text-zinc-500'
        }`;
      });
      const submitBtnText = document.getElementById('submit-btn-text');
      if (submitBtnText) submitBtnText.textContent = stepIndex === maxSteps ? 'Finaliser la demande' : 'Continuer';
      
      const progressText = document.getElementById('current-step-text');
      if (progressText) progressText.textContent = stepIndex.toString();
      
      if (backBtn) {
        if (stepIndex > 1) backBtn.classList.remove('hidden');
        else backBtn.classList.add('hidden');
      }
    }

    if (backBtn) {
      backBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (currentStep > 1) { currentStep--; showStep(currentStep); }
      });
    }

    function updatePriceDisplay() {
      const pkg = Array.from(packageInputs).find(r => (r as HTMLInputElement).checked) as HTMLInputElement;
      const pkgVal = pkg?.value || 'hourly';
      
      let totalHours = 0;
      let isDevis = false;

      if (pkgVal === 'hourly') {
        totalHours = Number(dailyHoursInput.value || 3);
      } else if (pkgVal === 'daily') {
        totalHours = Number(numberOfDaysInput.value || 1) * 8; // On assume 8h par jour
      } else if (pkgVal === 'monthly') {
        isDevis = true;
      }

      vehicleInputs.forEach((input) => {
        const radio = input as HTMLInputElement;
        const category = radio.value;
        const vehicleCard = radio.nextElementSibling as HTMLElement;
        if (!vehicleCard) return;
        const priceDiv = vehicleCard.querySelector('.price-display');
        
        const rule = pricingRules.find((r: any) => r.service_category?.toLowerCase() === category.toLowerCase());

        if (priceDiv) {
          if (isDevis || !rule || !rule.price_per_hour || totalHours === 0) {
            priceDiv.textContent = `Sur devis`;
            if (estimationNote) estimationNote.classList.remove('hidden');
          } else {
            let amount = totalHours * rule.price_per_hour;
            if (pkgVal === 'hourly' && amount < rule.minimum_fare) amount = rule.minimum_fare;
            priceDiv.textContent = `~ ${amount.toFixed(0)} €`;
            if (estimationNote) estimationNote.classList.add('hidden');
          }
        }
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      if (currentStep === 1) {
        if (!formData.get('packageType')) {
          alert("Veuillez sélectionner un type de forfait.");
          return;
        }
        if (!formData.get('startDate') || !formData.get('startTime')) {
          alert("Veuillez remplir les informations de début.");
          return;
        }
        currentStep++; showStep(currentStep);
        return;
      }

      if (currentStep === 2) {
        if (!formData.get('vehicle')) { alert("Veuillez choisir un véhicule."); return; }
        currentStep++; showStep(currentStep);
        return;
      }

      if (currentStep === 3) {
        if (!formData.get('mainLocation')) {
          alert("Veuillez préciser le lieu d'attente principal.");
          return;
        }
        currentStep++; showStep(currentStep);
        return;
      }

      if (currentStep === maxSteps) {
        if (!formData.get('companyName') || !formData.get('email') || !formData.get('phone')) {
          alert("Veuillez remplir vos coordonnées professionnelles.");
          return;
        }

        const originalText = submitBtn.textContent || '';
        submitBtn.textContent = 'Envoi de la demande...';
        submitBtn.disabled = true;

        try {
          alert("Tunnel B2B V1 terminé avec succès !");
          submitBtn.textContent = 'Demande envoyée';
        } catch (err: any) {
          console.error("Submit error:", err);
          alert(err.message || "Erreur lors de la soumission");
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      }
    });

    showStep(1);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTunnel);
  } else {
    initTunnel();
  }
</script>

---
// src/layouts/BaseLayout.astro
import Footer from "../components/ui/Footer.astro";
import Header from "../components/ui/Header.astro";
import "../styles/global.css";

const { title, description, minimal = false } = Astro.props;
const tenant = Astro.locals.tenant || { name: 'Elite Lyon', id: 'default' };
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | ${tenant.name}` : tenant.name}</title>
    <meta name="description" content={description || "Service de chauffeur privé haut de gamme."} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-black selection:bg-black selection:text-white overflow-x-hidden">

    {!minimal && <Header />}

    <main>
      <slot />
    </main>

    {!minimal && <Footer />}

  </body>
</html>

<style is:global>
  :root {
    --accent: #E21E26; /* Luxe Red */
    --accent-dark: #B9181E;
  }

  body {
    font-family: 'Outfit', sans-serif;
  }

  .font-sans {
    font-family: 'Outfit', sans-serif;
  }
</style>

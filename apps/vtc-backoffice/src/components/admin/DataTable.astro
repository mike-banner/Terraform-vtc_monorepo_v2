---
// src/components/admin/DataTable.astro
interface Props {
    title: string;
    description?: string;
    headers: string[];
    data: any[];
    emptyMessage?: string;
}

const { title, description, headers, data, emptyMessage = "Aucune donnée trouvée." } = Astro.props;
---

<div class="mb-12">
    <div class="flex items-end justify-between mb-8">
        <div>
            <h2 class="text-3xl font-black uppercase tracking-tight text-foreground">
                {title}
            </h2>
            {description && (
                <p class="text-sm font-medium text-muted-foreground mt-1.5">
                    {description}
                </p>
            )}
        </div>
        <div class="flex items-center gap-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            {data.length} entrées
        </div>
    </div>

    <div class="overflow-hidden border border-border/30 bg-card rounded-2xl shadow-xl relative">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/3 to-transparent pointer-events-none"></div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[800px]">
                <thead>
                    <tr class="bg-white/5 border-b border-border/30">
                        {headers.map((header) => (
                            <th class="px-6 py-4 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                                {header}
                            </th>
                        ))}
                    </tr>
                </thead>
                <tbody class="divide-y divide-border/20">
                    {data.length > 0 ? data.map((row) => (
                        <tr class="group hover:bg-white/3 transition-colors duration-150">
                            <slot name="row" row={row} />
                        </tr>
                    )) : (
                        <tr>
                            <td colspan={headers.length} class="px-12 py-20 text-center">
                                <span class="text-sm font-medium text-muted-foreground block">
                                    {emptyMessage}
                                </span>
                            </td>
                        </tr>
                    )}
                </tbody>
            </table>
        </div>
    </div>
</div>

---
// src/pages/index.astro
import MainLayout from "../layouts/MainLayout.astro";

const { profile } = Astro.locals;
const isAdmin = !!profile?.platform_role;
---

<MainLayout title="Accueil" hideFooter>
	<div class="flex-1 flex items-center justify-center px-4 relative z-10">
		<div class="glass p-8 sm:p-12 rounded-[2.5rem] text-center max-w-2xl w-full border border-border/50 shadow-[0_0_50px_-12px_rgba(225,193,110,0.15)] bg-card/30 backdrop-blur-md">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-[10px] font-bold uppercase tracking-widest mb-6">
				<span class="relative flex h-2 w-2">
					<span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
				</span>
				VTC SaaS - V1.0
			</div>

			<h1 class="text-[2.2rem] sm:text-5xl font-heading font-black mb-4 text-foreground tracking-tight uppercase leading-[1.1]">
				L'excellence <br/> du <span class="text-primary">VTC</span>
			</h1>
			<p class="text-muted-foreground text-sm sm:text-base mb-8 font-medium max-w-xl mx-auto leading-relaxed">
				Propulsez votre entreprise de transport avec une infrastructure technologique <span class="text-foreground">Elite</span>.
			</p>
			{isAdmin ? (
				<div class="flex flex-col items-center gap-4">
					<p class="text-xs text-muted-foreground font-medium">
						Vous êtes connecté en tant qu'administrateur plateforme.<br/>
						Cet espace est réservé aux chauffeurs et agences.
					</p>
					<button
						id="btn-admin-logout"
						class="px-8 py-3.5 bg-destructive/10 border border-destructive/20 text-destructive rounded-[var(--radius)] font-bold uppercase tracking-widest text-sm hover:bg-destructive/20 transition-all active:scale-[0.98]"
					>
						Se déconnecter
					</button>
				</div>
			) : (
				<div class="flex flex-col sm:flex-row gap-3 justify-center">
					<a
						href="/signup"
						class="px-8 py-3.5 bg-primary text-primary-foreground rounded-[var(--radius)] font-bold uppercase tracking-widest text-sm hover:bg-primary/90 transition-all shadow-xl shadow-primary/20 active:scale-[0.98]"
					>
						Démarrer maintenant
					</a>
					<button
						id="btn-learn-more"
						class="px-8 py-3.5 bg-transparent rounded-[var(--radius)] font-bold uppercase tracking-widest text-sm hover:bg-card hover:text-foreground text-muted-foreground transition-all border border-border active:scale-[0.98]"
					>
						En savoir plus
					</button>
				</div>
			)}

			<p class="mt-8 text-[11px] text-muted-foreground/50">&copy; {new Date().getFullYear()} VTC HUB</p>
		</div>
	</div>

	<!-- MODAL: EN SAVOIR PLUS -->
	<div id="modal-about" class="fixed inset-0 z-[100] flex items-center justify-center p-6 opacity-0 pointer-events-none transition-all duration-500">
		<div class="absolute inset-0 bg-background/80 backdrop-blur-sm modal-overlay"></div>

		<div class="relative bg-card/90 backdrop-blur-xl max-w-2xl w-full rounded-[2.5rem] border border-border shadow-2xl overflow-hidden transform scale-95 transition-transform duration-500">
			<!-- Close Button -->
			<button class="absolute top-8 right-8 text-muted-foreground hover:text-foreground transition-colors close-modal z-10">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>

			<div class="p-10 sm:p-16">
				<div class="w-16 h-16 bg-primary/10 border border-primary/20 rounded-[var(--radius)] flex items-center justify-center shadow-lg shadow-primary/10 mb-8 mx-auto sm:mx-0">
					<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
				</div>

				<h2 class="text-3xl font-heading font-black uppercase text-foreground tracking-tight mb-6 text-center sm:text-left">
					L'Écosystème <span class="text-primary">VTC MVP</span>
				</h2>

				<div class="space-y-8 text-left h-[400px] overflow-y-auto pr-4 custom-scrollbar">
					<p class="text-muted-foreground leading-relaxed font-medium">
						Bienvenue sur l'infrastructure de référence pour les professionnels du VTC. Notre plateforme n'est pas qu'un simple annuaire, c'est un <span class="text-foreground font-bold">ERP financier</span> et une <span class="text-foreground font-bold">centrale de réservation</span> privée.
					</p>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div class="p-5 rounded-[calc(var(--radius)+8px)] bg-background/50 border border-border/50 group hover:border-primary/50 transition-colors">
							<h3 class="text-primary font-bold uppercase text-[10px] tracking-widest mb-2">Finance & Ledger</h3>
							<p class="text-xs text-muted-foreground leading-relaxed">Transparence totale. Chaque euro est tracé dans un Grand Livre (Ledger) immuable. Fini les erreurs de calcul.</p>
						</div>
						<div class="p-5 rounded-[calc(var(--radius)+8px)] bg-background/50 border border-border/50 group hover:border-primary/50 transition-colors">
							<h3 class="text-primary font-bold uppercase text-[10px] tracking-widest mb-2">Gestion des Véhicules</h3>
							<p class="text-xs text-muted-foreground leading-relaxed">Partenaires, chauffeurs, véhicules. Gardez un contrôle absolu sur votre activité et celle de vos équipes.</p>
						</div>
						<div class="p-5 rounded-[calc(var(--radius)+8px)] bg-background/50 border border-border/50 group hover:border-primary/50 transition-colors">
							<h3 class="text-primary font-bold uppercase text-[10px] tracking-widest mb-2">Réservation Directe</h3>
							<p class="text-xs text-muted-foreground leading-relaxed">Un moteur de booking ultra-performant. Recevez vos paiements via Stripe de manière sécurisée et instantanée.</p>
						</div>
						<div class="p-5 rounded-[calc(var(--radius)+8px)] bg-background/50 border border-border/50 group hover:border-primary/50 transition-colors">
							<h3 class="text-primary font-bold uppercase text-[10px] tracking-widest mb-2">Dashboard Admin</h3>
							<p class="text-xs text-muted-foreground leading-relaxed">Une vision à 360° sur vos KPI, vos réservations en cours et vos litiges Stripe éventuels.</p>
						</div>
					</div>

					<div class="p-6 rounded-[calc(var(--radius)+8px)] bg-primary/5 border border-primary/20">
						<h4 class="text-foreground font-bold uppercase text-xs mb-3 tracking-widest">En tant que nouveau membre :</h4>
						<ul class="text-[11px] text-muted-foreground space-y-2 list-disc list-inside font-medium">
							<li>Finalisez votre onboarding en téléchargeant vos documents.</li>
							<li>Configurez vos tarifs personnalisés (Zones, Forfaits).</li>
							<li>Commencez à opérer sous votre propre domaine ou via la plateforme.</li>
						</ul>
					</div>
				</div>

				<div class="mt-8 flex justify-center sm:justify-start">
					<button class="px-8 py-3.5 sm:px-12 sm:py-4 bg-foreground text-background font-bold uppercase tracking-widest text-xs sm:text-sm rounded-[var(--radius)] hover:bg-foreground/90 transition-all active:scale-[0.98] close-modal">
						J'ai compris
					</button>
				</div>
			</div>
		</div>
	</div>

	<style>
		.glass {
			background: rgba(15, 23, 42, 0.4);
		}

		#modal-about.is-active {
			opacity: 1;
			pointer-events: auto;
		}

		#modal-about.is-active > div:last-child {
			transform: scale(1);
		}

		.custom-scrollbar::-webkit-scrollbar {
			width: 4px;
		}
		.custom-scrollbar::-webkit-scrollbar-track {
			background: transparent;
		}
		.custom-scrollbar::-webkit-scrollbar-thumb {
			background: rgba(255, 255, 255, 0.1);
			border-radius: 10px;
		}
	</style>

	<script>
		import { supabase } from "@/lib/supabase/client";

		document.getElementById('btn-admin-logout')?.addEventListener('click', async () => {
			await supabase.auth.signOut();
			window.location.reload();
		});

		const btn = document.getElementById('btn-learn-more');
		const modal = document.getElementById('modal-about');
		const closeBtns = document.querySelectorAll('.close-modal');
		const overlay = document.querySelector('.modal-overlay');

		const toggleModal = () => {
			modal?.classList.toggle('is-active');
		};

		btn?.addEventListener('click', toggleModal);
		closeBtns.forEach(b => b.addEventListener('click', toggleModal));
		overlay?.addEventListener('click', toggleModal);

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal?.classList.contains('is-active')) {
				toggleModal();
			}
		});
	</script>
</MainLayout>

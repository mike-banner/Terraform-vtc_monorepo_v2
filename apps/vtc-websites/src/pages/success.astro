---
import { supabase } from "../core/supabase";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusPage from "../components/ui/StatusPage.astro";


const sessionId = Astro.url.searchParams.get("session_id");

let booking = null;
let error = null;

async function wait(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

if (sessionId) {
  // Le webhook Stripe crée la réservation de façon asynchrone : on retente
  // quelques secondes. Passe par la RPC `get_public_booking_result`
  // (SECURITY DEFINER) : `bookings`, `customers` et `stripe_events` ne sont
  // plus lisibles avec la clé publique (cf. migration security_hardening).
  for (let i = 0; i < 8; i++) {
    const { data, error: rpcError } = await supabase
      .rpc("get_public_booking_result", { p_session_id: sessionId })
      .maybeSingle();

    if (data) {
      booking = data;
      break;
    }

    if (rpcError) {
      console.error("get_public_booking_result:", rpcError.message);
      break;
    }

    await wait(1000);
  }
}

// Sans session Stripe, la page n'a pas de sens : retour à l'accueil.
if (!sessionId) return Astro.redirect("/");

let paymentState = "pending";
if (!booking) {
  error = true;
  const { data: state } = await supabase.rpc("get_public_payment_state", { p_session_id: sessionId });
  if (state === "failed") paymentState = "failed";
}
const { tenant } = Astro.locals;
const buttonClass = "inline-flex h-11 w-full items-center justify-center rounded-md bg-ui-ink px-4 text-sm font-semibold text-ui-card transition-colors hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-ink";
---

<BaseLayout title="Réservation" minimal>
  {error || !booking ? (
    paymentState === "failed" ? (
      <StatusPage tone="error" title="Paiement reçu, réservation à confirmer" tenantName={tenant?.name}>
        <p>Votre paiement a bien été reçu, mais votre réservation n'a pas pu être enregistrée automatiquement. {tenant?.name ?? "Votre chauffeur"} a été prévenu et vous contacte rapidement. À défaut, vous serez remboursé.</p>
        {(tenant?.phone || tenant?.email) && <p>Pour aller plus vite : {[tenant?.phone, tenant?.email].filter(Boolean).join(' · ')}.</p>}
        <a slot="actions" href="/" class={buttonClass}>Retour à l'accueil</a>
      </StatusPage>
    ) : (
      <StatusPage tone="pending" title="Confirmation en cours" tenantName={tenant?.name}>
        <p>Votre réservation n'est pas encore confirmée. Si votre paiement a été débité, elle le sera dans quelques minutes et vous recevrez un email.</p>
        <p>Sans nouvelle de notre part, contactez-nous{(tenant?.phone || tenant?.email) && ` : ${[tenant?.phone, tenant?.email].filter(Boolean).join(' · ')}`}.</p>
        <a slot="actions" href="/" class={buttonClass}>Retour à l'accueil</a>
      </StatusPage>
    )
  ) : (
    <StatusPage tone="success" title={`Merci ${booking.customer_first_name || ''}, votre course est réservée`.replace(' ,', ',')} tenantName={tenant?.name}>
      <dl class="divide-y divide-ui-line rounded-md border border-ui-line">
        <div class="flex justify-between gap-4 px-4 py-3"><dt>Référence</dt><dd class="font-medium text-ui-ink">{booking.booking_id.slice(0, 8).toUpperCase()}</dd></div>
        <div class="flex justify-between gap-4 px-4 py-3"><dt>Prise en charge</dt><dd class="text-right font-medium text-ui-ink">{booking.pickup_address}</dd></div>
        {booking.dropoff_address && (
          <div class="flex justify-between gap-4 px-4 py-3"><dt>Destination</dt><dd class="text-right font-medium text-ui-ink">{booking.dropoff_address}</dd></div>
        )}
        <div class="flex justify-between gap-4 px-4 py-3"><dt>Total payé</dt><dd class="font-semibold text-ui-ink">{Number(booking.total_amount).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' })}</dd></div>
      </dl>
      <a slot="actions" href="/" class={buttonClass}>Retour à l'accueil</a>
    </StatusPage>
  )}
</BaseLayout>

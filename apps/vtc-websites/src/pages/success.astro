---
import { supabase } from "../core/supabase";
import BaseLayout from "../layouts/BaseLayout.astro";


const sessionId = Astro.url.searchParams.get("session_id");

let booking = null;
let error = null;

async function wait(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

if (sessionId) {
  // Le webhook Stripe crée la réservation de façon asynchrone : on retente
  // quelques secondes. Passe par la RPC `get_public_booking_result`
  // (SECURITY DEFINER) : `bookings`, `customers` et `stripe_events` ne sont
  // plus lisibles avec la clé publique (cf. migration security_hardening).
  for (let i = 0; i < 8; i++) {
    const { data, error: rpcError } = await supabase
      .rpc("get_public_booking_result", { p_session_id: sessionId })
      .maybeSingle();

    if (data) {
      booking = data;
      break;
    }

    if (rpcError) {
      console.error("get_public_booking_result:", rpcError.message);
      break;
    }

    await wait(1000);
  }
}

if (!booking) {
  error = true;
}
---

<BaseLayout title="Réservation Confirmée">
  <div class="min-h-screen bg-zinc-50 flex items-center justify-center py-12 px-4 italic">
    <div class="max-w-md w-full bg-white shadow-2xl rounded-sm p-8 border-t-8 border-green-500">

      {error || !booking ? (
        <div class="text-center">
          <h1 class="text-2xl font-black text-red-600 mb-4 uppercase">Erreur de confirmation</h1>
          <p class="text-zinc-600 font-bold">Nous n'avons pas trouvé votre réservation, mais le paiement a peut-être été validé. Contactez-nous.</p>
          <a href="/booking-transfert" class="btn bg-black text-white mt-8 w-full h-14 rounded-sm uppercase font-black tracking-widest hover:bg-zinc-800 transition-colors border-none flex items-center justify-center">Retour au formulaire</a>
        </div>
      ) : (
        <div class="text-center">
          <div class="mb-6 inline-flex items-center justify-center w-16 h-16 bg-green-100 text-green-500 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <h1 class="text-3xl font-black text-black mb-2 uppercase tracking-tighter">Merci {booking.customer_first_name || 'Cher client'} !</h1>
          <p class="text-zinc-500 font-bold mb-8 uppercase text-xs tracking-widest">Votre course est officiellement réservée</p>

          <div class="bg-zinc-100 p-6 rounded-sm text-left mb-8 space-y-3 font-bold text-sm uppercase">
            <div class="flex justify-between border-b border-zinc-200 pb-2">
              <span class="text-zinc-400">Référence</span>
              <span class="text-black font-black">{booking.booking_id.slice(0, 8).toUpperCase()}</span>
            </div>
            <div class="flex justify-between border-b border-zinc-200 pb-2 text-[10px]">
              <span class="text-zinc-400">Prise en charge</span>
              <span class="text-black text-right max-w-[200px] truncate">{booking.pickup_address}</span>
            </div>
            {booking.dropoff_address && (
              <div class="flex justify-between border-b border-zinc-200 pb-2 text-[10px]">
                <span class="text-zinc-400">Destination</span>
                <span class="text-black text-right max-w-[200px] truncate">{booking.dropoff_address}</span>
              </div>
            )}
            <div class="flex justify-between pt-2">
              <span class="text-zinc-400">Total payé</span>
              <span class="text-green-600 font-black text-lg">{booking.total_amount} €</span>
            </div>
          </div>

          <a href="/" class="btn bg-black text-white w-full h-14 font-black uppercase tracking-widest rounded-sm hover:bg-zinc-800 transition-colors border-none flex items-center justify-center">
            Retour à l'accueil
          </a>

          {booking.customer_email && (
            <p class="mt-6 text-[10px] text-zinc-400 font-bold uppercase italic">Un email de confirmation a été envoyé à {booking.customer_email}</p>
          )}
        </div>
      )}
    </div>
  </div>
</BaseLayout>



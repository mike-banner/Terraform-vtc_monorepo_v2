---
// Ne sert que la landing du site choisi par domaine (D-29 c) ; tunnels et pages fonctionnelles sont des routes communes.
import { landings } from "virtual:vtc-sites";
import { resolveSite } from "../router/siteResolver";
import NotFound from "../components/ui/NotFound.astro";

const site = resolveSite(Astro.url.host);
const path = (Astro.params.path || "").replace(/\/$/, "");
const Page = path === "" ? (await landings[site]?.())?.default : undefined;
---

{Page ? <Page /> : <NotFound />}

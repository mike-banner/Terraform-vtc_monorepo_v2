---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/elite-van-hero-city.png';
import EliteBookingWidget from './EliteBookingWidget.astro';
---

<section
  id='hero'
  class='relative min-h-[100dvh] flex items-center pt-28 pb-16 lg:py-20 overflow-hidden bg-[#0B0F15]'>
  <!-- PHOTO D'ARRIÈRE-PLAN D'ORIGINE RESTAURÉE -->
  <div class='absolute inset-0 z-0 pointer-events-none'>
    <Image
      class='w-full h-full object-cover object-center opacity-90 scale-105 lg:scale-100 transition-transform duration-1000'
      src={heroImage}
      alt='Elite Chauffeur Privé Lyon'
      loading='eager'
      format='webp'
      quality='high'
    />
    <!-- Filtre Bleu Acier Léger (#6185B2) -->
    <div class='absolute inset-0 bg-[#6185b2]/15 mix-blend-color'></div>
    <!-- Dégradé Réduit -->
    <div class='absolute inset-0 bg-gradient-to-t from-[#0B0F15] via-[#0B0F15]/50 to-transparent'></div>
    <div class='absolute inset-0 bg-gradient-to-r from-[#0B0F15]/80 via-transparent to-transparent'></div>
  </div>

  <div class='container mx-auto px-6 sm:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center'>
    <!-- CONTENU GAUCHE -->
    <div class='lg:col-span-7 flex flex-col justify-center items-center lg:items-start text-center lg:text-left pt-6 lg:pt-0'>
      <span class='text-elite-accent font-label font-bold tracking-[0.3em] uppercase mb-4 text-[10px] sm:text-xs'>
        Premium Fleet Service
      </span>
      <h1 class='text-white font-headline text-4xl sm:text-6xl lg:text-8xl font-extrabold tracking-tighter leading-[0.9] mb-6 uppercase'>
        Chauffeur<br class="hidden lg:inline" /> <span class='text-elite-accent'>Privé</span> De Luxe
      </h1>
      <p class='text-white/80 font-body text-base sm:text-lg lg:text-xl max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed font-normal'>
        L'excellence opérationnelle pour vos déplacements stratégiques. Discrétion, ponctualité et prestige.
      </p>

      <!-- BOUTONS CTAs BLEU ACIER VISIBLES MOBILE ET DESKTOP -->
      <div class='flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto'>
        <a
          href='#booking'
          class='btn-premium w-full sm:w-auto px-8 py-4 rounded-sm font-headline font-bold text-xs sm:text-sm uppercase tracking-[0.2em] text-center min-h-[48px] flex items-center justify-center active:scale-95 shadow-accent'>
          Réserver un trajet
        </a>
        <a
          href='#services'
          class='w-full sm:w-auto px-8 py-4 border border-white/20 text-white rounded-sm font-headline font-medium text-xs sm:text-sm uppercase tracking-[0.2em] text-center backdrop-blur-sm hover:bg-white/10 transition-colors min-h-[48px] flex items-center justify-center active:scale-95'>
          La Flotte
        </a>
      </div>
    </div>

    <!-- WIDGET DE RÉSERVATION DROITE -->
    <div id='booking' class='lg:col-span-5 flex items-center w-full mt-4 lg:mt-0'>
      <EliteBookingWidget />
    </div>
  </div>
</section>

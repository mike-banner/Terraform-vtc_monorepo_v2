---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/elite-van-hero-city.png';
import EliteBookingWidget from './EliteBookingWidget.astro';
---

<section
  id='hero'
  class='relative min-h-[100dvh] flex items-center pt-28 pb-16 lg:py-24 overflow-hidden bg-black'>
  <!-- BACKGROUND IMAGE & GRADIENT SCRIMS -->
  <div class='absolute inset-0 z-0 pointer-events-none'>
    <Image
      class='w-full h-full object-cover object-center opacity-40 scale-105 transition-transform duration-1000'
      src={heroImage}
      alt='Elite Chauffeur Privé Lyon'
      loading='eager'
      format='webp'
      quality='high'
    />
    <!-- Gradient Overlay Sombre & Or -->
    <div class='absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/40'></div>
    <div class='absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent'></div>
    <div class='absolute top-1/4 left-10 w-96 h-96 bg-amber-500/10 blur-[140px] rounded-full'></div>
  </div>

  <div class='container mx-auto px-6 sm:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center'>
    <!-- CONTENU GAUCHE -->
    <div class='lg:col-span-7 flex flex-col justify-center items-center lg:items-start text-center lg:text-left pt-6 lg:pt-0'>
      <!-- BADGE EYEBROW -->
      <div class='inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-bold uppercase tracking-[0.25em] mb-6 shadow-lg shadow-amber-500/5'>
        <span class='relative flex h-2 w-2'>
          <span class='motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75'></span>
          <span class='relative inline-flex rounded-full h-2 w-2 bg-amber-500'></span>
        </span>
        Chauffeur Privé & Conciergerie Lyon
      </div>

      <!-- TITRE PRINCIPAL -->
      <h1 class='text-white font-headline text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[0.95] mb-6 uppercase'>
        L'Excellence <br /> <span class='text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-500'>Du Sur-Mesure</span>
      </h1>

      <!-- SOUS-TITRE -->
      <p class='text-slate-300 font-body text-sm sm:text-base lg:text-lg max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed font-medium'>
        Service de transfert haut de gamme, berlines & vans de prestige. Discrétion absolue, ponctualité garantie 24/7 sur Lyon et sa région.
      </p>

      <!-- BOUTONS CTAs (Accessibles Mobile & Desktop) -->
      <div class='flex flex-col sm:flex-row items-center gap-3.5 w-full sm:w-auto'>
        <a
          href='#booking'
          class='w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-black font-headline font-black text-xs sm:text-sm uppercase tracking-[0.2em] rounded-xl transition-all shadow-xl shadow-amber-500/20 active:scale-95 text-center min-h-[48px] flex items-center justify-center'>
          Réserver une course
        </a>
        <a
          href='#services'
          class='w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-headline font-bold text-xs sm:text-sm uppercase tracking-[0.2em] rounded-xl transition-all border border-white/10 active:scale-95 text-center backdrop-blur-md min-h-[48px] flex items-center justify-center'>
          Découvrir la flotte
        </a>
      </div>
    </div>

    <!-- WIDGET DE RÉSERVATION DROITE -->
    <div id='booking' class='lg:col-span-5 flex items-center w-full mt-4 lg:mt-0'>
      <EliteBookingWidget />
    </div>
  </div>
</section>

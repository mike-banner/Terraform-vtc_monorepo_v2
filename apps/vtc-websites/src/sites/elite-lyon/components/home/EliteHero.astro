---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/elite-van-hero-wide.jpg';
import EliteBookingWidget from './EliteBookingWidget.astro';
---

<section id='hero' class='bg-[#151F2B] pt-20 sm:pt-24 pb-16 lg:pb-24'>
  <!-- PHOTO CADRÉE DANS LA PAGE : aucun voile, la photo porte seule le hero -->
  <div class='mx-auto max-w-[1600px] px-4 sm:px-6'>
    <div class='overflow-hidden rounded-2xl sm:rounded-3xl border border-white/10 aspect-[4/3] sm:aspect-[16/7] lg:aspect-[8/3]'>
      <Image
        class='h-full w-full object-cover object-[55%_center]'
        src={heroImage}
        alt='Mercedes Classe V noire en circulation dans le quartier d&apos;affaires de Lyon au crépuscule'
        loading='eager'
        format='webp'
        quality={82}
      />
    </div>
  </div>

  <!-- TEXTE ET RÉSERVATION SOUS LA PHOTO -->
  <div class='mx-auto mt-10 lg:mt-14 grid max-w-[1400px] grid-cols-1 gap-10 px-6 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:items-start'>
    <div class='lg:col-span-7'>
      <p class='mb-4 font-label text-xs font-semibold uppercase tracking-[0.25em] text-[#719DCC]'>
        Chauffeur privé — Lyon et Rhône-Alpes
      </p>
      <h1 class='mb-5 font-headline text-3xl font-bold leading-[1.05] tracking-tighter text-white sm:text-5xl'>
        Chauffeur privé de luxe
      </h1>
      <p class='mb-8 max-w-[52ch] font-body text-base leading-relaxed text-slate-300 sm:text-lg'>
        Vos déplacements professionnels et privés, avec discrétion et ponctualité, 24 h sur 24.
      </p>
      <a
        href='#services'
        class='btn-premium group inline-flex w-full items-center justify-center gap-3 px-10 py-4 text-center text-xs uppercase tracking-[0.2em] sm:w-auto sm:text-sm'>
        <span>Réserver un trajet</span>
        <svg class='h-4 w-4 transition-transform group-hover:translate-x-1' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='M14 5l7 7m0 0l-7 7m7-7H3' />
        </svg>
      </a>
    </div>

    <div id='booking' class='lg:col-span-5 w-full'>
      <EliteBookingWidget />
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/elite-van-hero-city.png';
import EliteBookingWidget from './EliteBookingWidget.astro';
---

<section
  id='hero'
  class='relative min-h-[100dvh] flex items-center pt-28 pb-16 lg:py-24 overflow-hidden bg-[#F8FAFC]'>
  
  <!-- BACKGROUND LUMINEUX AVEC DÉGRADÉ SOFT & IMAGE VÉHICULE EN HAUTE CLARTÉ -->
  <div class='absolute inset-0 z-0 pointer-events-none'>
    <!-- IMAGE DU VÉHICULE EN HAUTE DÉFINITION CLAIRE -->
    <Image
      class='w-full h-full object-cover object-center opacity-85 scale-105 transition-all duration-1000 mix-blend-multiply'
      src={heroImage}
      alt='Elite Chauffeur Privé Lyon'
      loading='eager'
      format='webp'
      quality='high'
    />
    <!-- Dégradé lumineux nacré / bleu acier doux -->
    <div class='absolute inset-0 bg-gradient-to-r from-[#F8FAFC] via-[#F8FAFC]/80 to-transparent'></div>
    <div class='absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(97,133,178,0.15)_0%,transparent_70%)]'></div>
    <div class='absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#F8FAFC] to-transparent'></div>
  </div>

  <div class='container mx-auto px-6 sm:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center'>
    
    <!-- CONTENU GAUCHE : TEXTE SOMBRE ET CTAS BLEU ACIER -->
    <div class='lg:col-span-7 flex flex-col justify-center items-center lg:items-start text-center lg:text-left pt-4 lg:pt-0'>
      
      <!-- BADGE EYEBROW BLEU ACIER SOMBRE -->
      <div class='inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#6185B2]/10 border border-[#6185B2]/20 text-[#446598] text-[10px] sm:text-xs font-bold uppercase tracking-[0.25em] mb-6 shadow-sm backdrop-blur-md'>
        <span class='relative flex h-2 w-2'>
          <span class='motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-[#6185B2] opacity-75'></span>
          <span class='relative inline-flex rounded-full h-2 w-2 bg-[#446598]'></span>
        </span>
        Chauffeur Privé & Conciergerie Lyon
      </div>

      <!-- TITRE PRINCIPAL SOMBRE -->
      <h1 class='text-[#0F172A] font-headline text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[0.95] mb-6 uppercase'>
        L'Excellence <br /> <span class='text-transparent bg-clip-text bg-gradient-to-r from-[#446598] via-[#6185B2] to-[#719DCC]'>Du Sur-Mesure</span>
      </h1>

      <!-- SOUS-TITRE LEGEREMENT GRISÉ -->
      <p class='text-[#0F172A]/80 font-body text-base sm:text-lg lg:text-xl max-w-xl mx-auto lg:mx-0 mb-10 leading-relaxed font-normal'>
        Service de transfert haut de gamme, berlines & vans de prestige. Discrétion absolue, ponctualité garantie 24/7 sur Lyon et sa région.
      </p>

      <!-- BOUTONS CTAS (DESIGN SYSTEM BLEU ACIER SOMBRE) -->
      <div class='flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto'>
        <!-- CTA PRINCIPAL -->
        <a
          href='#booking'
          class='w-full sm:w-auto px-9 py-4 bg-[#6185B2] hover:bg-[#446598] text-white font-headline font-bold text-xs sm:text-sm uppercase tracking-[0.2em] rounded-xl transition-all duration-300 shadow-xl shadow-[#6185B2]/20 hover:shadow-2xl active:scale-95 text-center min-h-[50px] flex items-center justify-center gap-3 group'>
          <span>Réserver un trajet</span>
          <svg class='w-4 h-4 transition-transform group-hover:translate-x-1' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='M14 5l7 7m0 0l-7 7m7-7H3' />
          </svg>
        </a>

        <!-- CTA SECONDAIRE FOND CLAIR -->
        <a
          href='#services'
          class='w-full sm:w-auto px-9 py-4 bg-white hover:bg-slate-100 text-[#0F172A] font-headline font-semibold text-xs sm:text-sm uppercase tracking-[0.2em] rounded-xl transition-all duration-300 border border-slate-200 shadow-sm active:scale-95 text-center min-h-[50px] flex items-center justify-center'>
          Découvrir la flotte
        </a>
      </div>
    </div>

    <!-- WIDGET DE RÉSERVATION DROITE -->
    <div id='booking' class='lg:col-span-5 flex items-center w-full mt-6 lg:mt-0'>
      <EliteBookingWidget />
    </div>

  </div>
</section>

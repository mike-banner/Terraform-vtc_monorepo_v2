---
// src/sites/elite-lyon/components/home/EliteFooter.astro
const { tenant } = Astro.locals;
const tenantName = tenant?.name || 'Elite Lyon';
---

<footer class='bg-black text-white py-24 border-t border-elite-accent/20'>
  <div class='container mx-auto px-8'>
    <div class='grid grid-cols-1 md:grid-cols-4 gap-16 text-center md:text-left'>
      <div class='md:col-span-2'>
        <div class='text-2xl font-bold tracking-tighter text-elite-accent uppercase mb-8'>
          {tenantName}
        </div>
        <p class='text-white/40 text-sm leading-loose max-w-sm mx-auto md:mx-0'>
          L'excellence du transport de prestige à Lyon et dans toute la région Rhône-Alpes.
        </p>
      </div>
      <div>
        <h4
          class='font-headline font-bold mb-8 uppercase text-[10px] tracking-[0.3em] text-elite-accent'>
          Navigation
        </h4>
        <ul class='space-y-4 text-white/60 text-xs uppercase tracking-widest font-bold'>
          <li><a href='#services' class='hover:text-elite-accent transition-colors'>Services</a></li>
          <li><a href='#fleet' class='hover:text-elite-accent transition-colors'>Fleet</a></li>
          <li>
            <a href='#concierge' class='hover:text-elite-accent transition-colors'>Concierge</a>
          </li>
        </ul>
      </div>
      <div>
        <h4
          class='font-headline font-bold mb-8 uppercase text-[10px] tracking-[0.3em] text-elite-accent'>
          Contact
        </h4>
        <p class='text-white/60 text-xs uppercase tracking-widest font-bold leading-loose'>
          Lyon, France<br />
          {tenant?.phone}<br />
          contact@elite-lyon.fr
        </p>
      </div>
    </div>
    <div
      class='mt-24 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-[9px] uppercase tracking-[0.2em] text-white/30 font-bold'>
      <p>© 2026 {tenantName}. All Rights Reserved.</p>
      <div class='flex gap-8 mt-4 md:mt-0'>
        <a href='/legal' class='hover:text-elite-accent transition-colors'>Legal notice</a>
        <a href='/privacy' class='hover:text-elite-accent transition-colors'>Privacy policy</a>
      </div>
    </div>
  </div>
</footer>

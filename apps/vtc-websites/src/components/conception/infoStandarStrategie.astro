---
// src/components/conception/infoStandarStrategie.astro
import discretionImg from '../../assets/images/elite-discretion.jpg';
import disponibiliteImg from '../../assets/images/elite-disponibilite.jpg';
---

<div class='grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-24 items-center'>
  <!-- IMAGES ÉCLAIRCIES AVEC CARTES BLEU ACIER NUIT -->
  <div class='order-2 md:order-1'>
    <div class='grid grid-cols-2 gap-6 sm:gap-8'>
      <!-- Image 1 : Discrétion -->
      <div
        class='relative aspect-square flex flex-col items-center justify-center p-6 rounded-2xl border border-[#6185B2]/30 overflow-hidden group shadow-2xl bg-[#0B0F15]'>
        <div class="absolute inset-0 bg-cover bg-center opacity-90 brightness-110 contrast-105 transition-transform duration-700 group-hover:scale-105" style={`background-image: url(${discretionImg.src});`}></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F15]/85 via-transparent to-transparent"></div>
        <div class="relative z-10 text-center bg-[#0B0F15]/75 backdrop-blur-md px-4 py-3 rounded-xl border border-white/10 shadow-lg">
          <span class='text-2xl sm:text-3xl font-headline font-black text-white uppercase tracking-tight'>100%</span>
          <span class='text-[9px] sm:text-[10px] font-label uppercase tracking-widest text-[#719DCC] font-bold mt-1 block'>Discrétion</span>
        </div>
      </div>

      <!-- Image 2 : Disponibilité -->
      <div
        class='relative aspect-square flex flex-col items-center justify-center p-6 rounded-2xl border border-[#6185B2]/30 overflow-hidden group shadow-2xl bg-[#0B0F15]'>
        <div class="absolute inset-0 bg-cover bg-center opacity-90 brightness-110 contrast-105 transition-transform duration-700 group-hover:scale-105" style={`background-image: url(${disponibiliteImg.src});`}></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F15]/85 via-transparent to-transparent"></div>
        <div class="relative z-10 text-center bg-[#0B0F15]/75 backdrop-blur-md px-4 py-3 rounded-xl border border-white/10 shadow-lg">
          <span class='text-2xl sm:text-3xl font-headline font-black text-white uppercase tracking-tight'>24/7</span>
          <span class='text-[9px] sm:text-[10px] font-label uppercase tracking-widest text-[#719DCC] font-bold mt-1 block'>Disponibilité</span>
        </div>
      </div>
    </div>
  </div>

  <!-- TEXTE STRATEGIC STANDARD SOULEVÉ SUR FOND NUIT -->
  <div class='order-1 md:order-2 flex flex-col items-center text-center md:text-left md:items-start'>
    <span class='text-[#719DCC] font-label font-bold tracking-[0.3em] uppercase text-xs mb-3 block'
      >Strategic Standard</span
    >
    <h2
      class='text-white font-headline text-4xl md:text-6xl font-extrabold uppercase tracking-tighter mb-6'>
      L'Expérience<br /><span class='text-[#719DCC]'>Elite</span>
    </h2>
    <p class='text-slate-300 font-body text-base leading-relaxed mb-8 max-w-md mx-auto md:mx-0'>
      Nous comprenons que chaque trajet est une opportunité critique. Notre protocole d'excellence
      garantit une exécution sans faille pour vos enjeux de mobilité.
    </p>
    <div class='space-y-4 w-full'>
      <div class='flex flex-col items-center md:flex-row md:items-start gap-3 md:gap-4 p-4 rounded-xl bg-[#0B0F15]/60 border border-[#6185B2]/20 backdrop-blur-md shadow-sm'>
        <span class='material-symbols-outlined text-[#719DCC] text-xl'>verified</span>
        <p class='text-white font-bold text-xs uppercase tracking-widest text-center md:text-left font-headline'>
          Chauffeurs polyglottes & certifiés
        </p>
      </div>
      <div class='flex flex-col items-center md:flex-row md:items-start gap-3 md:gap-4 p-4 rounded-xl bg-[#0B0F15]/60 border border-[#6185B2]/20 backdrop-blur-md shadow-sm'>
        <span class='material-symbols-outlined text-[#719DCC] text-xl'>verified</span>
        <p class='text-white font-bold text-xs uppercase tracking-widest text-center md:text-left font-headline'>
          Protocoles de sécurité VIP
        </p>
      </div>
    </div>
  </div>
</div>

---
// src/components/tunnels/AvailabilityTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';
import ContactStep from './steps/ContactStep.astro';
import VehicleGridStep from './steps/VehicleGridStep.astro';
import { supabase } from '../../core/supabase';
import { configDuSite } from '../../core/site-config';
import DateTimePicker from './steps/DateTimePicker.astro';

const { tenant } = Astro.locals;
const site = configDuSite(Astro.url.host);
const tenantId = tenant?.id || "";

// Récupération des données
const { data: vehiclesData } = await supabase.rpc('get_available_vehicles', { p_tenant_id: tenantId });
const availableVehicles = vehiclesData || [];

const vehicleTypes = availableVehicles.map((v: any) => ({
  type: v.category,
  id: v.id,
  name: `${v.brand} ${v.model}`,
  seats: v.capacity,
  price: 'Sur devis', // le prix est fixé par le chauffeur, communiqué par le devis
  icon: v.category.toLowerCase().includes('van') ? 'ri:bus-2-line' : (v.category.toLowerCase().includes('business') ? 'ri:briefcase-line' : 'ri:car-line')
}));

const useCases = [
  { id: 'shopping', name: 'Shopping & Visites', icon: 'ri:shopping-bag-line', desc: 'Accompagnement shopping et visites' },
  { id: 'events', name: 'Événements', icon: 'ri:calendar-event-line', desc: 'Mariages, galas, cérémonies' },
  { id: 'medical', name: 'Accompagnement médical', icon: 'ri:hospital-line', desc: 'Rendez-vous médicaux' },
  { id: 'family', name: 'Transport familial', icon: 'ri:team-line', desc: 'Déplacements en famille' },
  { id: 'airport', name: 'Transferts multiples', icon: 'ri:plane-line', desc: 'Plusieurs allers-retours aéroport' },
  { id: 'custom', name: 'Usage personnalisé', icon: 'ri:user-star-line', desc: 'Besoins spécifiques sur mesure' },
];

const { ...props } = Astro.props;
---
<TunnelLayout currentStep={1} totalSteps={4} serviceType='availability' {...props}>
  <div id="tunnel-data" data-tenant-id={tenantId} class="hidden"></div>
  <form id='tunnel-form' class='max-w-4xl mx-auto' novalidate>
    
    <!-- Étape 1: Durée & Date -->
    <div class='step-container' data-step='1'>
      <div class='mb-6'>
        <h2 class='text-2xl font-bold text-ui-ink mb-1'>Période de mise à disposition</h2>
        <p class='text-ui-muted mb-5'>Indiquez le début et la fin de la période. Le prix vous est communiqué par devis.</p>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 mb-4'>
          <fieldset>
            <legend class='text-sm font-semibold text-ui-ink mb-2'>Début</legend>
            <DateTimePicker dateName='serviceDate' timeName='startTime' dateLabel='Date' timeLabel='Heure' />
          </fieldset>
          <fieldset>
            <legend class='text-sm font-semibold text-ui-ink mb-2'>Fin</legend>
            <DateTimePicker dateName='endDate' timeName='endTime' dateLabel='Date' timeLabel='Heure' />
          </fieldset>
        </div>

        <div>
          <label class='block text-sm font-medium text-ui-ink mb-1.5'>Zone de prise en charge initiale</label>
          <input type='text' name='initialPickup' placeholder='Ex: Hôtel, domicile, gare...' class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary' required />
        </div>
      </div>
    </div>

    <!-- Étape 2: Véhicule -->
    <VehicleGridStep 
      stepNumber={2} 
      vehicleTypes={vehicleTypes} 
      title="Choisissez votre véhicule"
      subtitle="Sélectionnez la gamme pour votre mise à disposition. Le prix vous est communiqué par devis."
    />

    <!-- Étape 3: Type d'utilisation & Options -->
    <div class='step-container hidden' data-step='3'>
      <div class='mb-6'>
        <h2 class='text-2xl font-bold text-ui-ink mb-1'>Programme de l'excursion</h2>
        <p class='text-ui-muted mb-5'>Détaillez le programme de votre journée pour que notre chauffeur s'adapte à vos besoins</p>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-3 mb-4'>
          {
            useCases.map((useCase) => (
              <label class='relative group cursor-pointer'>
                <input type='radio' name='useCase' value={useCase.id} class='sr-only peer' />
                <div class='p-4 border-2 border-ui-line rounded-xl hover:border-primary transition-all duration-300 peer-checked:border-primary peer-checked:bg-primary/5 h-full flex items-center gap-3'>
                  <div class='w-9 h-9 shrink-0 rounded-lg bg-ui-page flex items-center justify-center group-hover:bg-primary/10 transition-colors'>
                    <Icon name={useCase.icon} class='text-lg text-ui-muted group-hover:text-primary' />
                  </div>
                  <div>
                    <h3 class='text-base font-semibold text-ui-ink leading-tight'>{useCase.name}</h3>
                    <p class='text-xs text-ui-muted'>{useCase.desc}</p>
                  </div>
                </div>
                <div class='absolute top-2 right-2 w-5 h-5 border-2 border-ui-line-strong rounded-full peer-checked:border-primary peer-checked:bg-primary flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                  <Icon name='ri:check-line' class='text-white text-xs' />
                </div>
              </label>
            ))
          }
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3'>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Nombre de passagers</label>
            <select name='passengerCount' class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary' required>
              <option value='1'>1 passager</option>
              <option value='2'>2 passagers</option>
              <option value='3'>3 passagers</option>
              <option value='4'>4 passagers</option>
              <option value='5'>5 passagers</option>
              <option value='6'>6 passagers</option>
            </select>
          </div>

          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Options (sur devis)</label>
            <div class='flex flex-col gap-2'>
              <label class='flex items-center gap-3 cursor-pointer p-2 border border-ui-line rounded-lg hover:bg-ui-page transition-colors'>
                <input type='checkbox' name='optionTranslator' value='yes' class='w-5 h-5 text-primary rounded focus:ring-primary' />
                <span class='text-sm font-medium text-ui-ink' title='Un professionnel bilingue vous accompagne.'>Traducteur / interprète</span>
              </label>
              <label class='flex items-center gap-3 cursor-pointer p-2 border border-ui-line rounded-lg hover:bg-ui-page transition-colors'>
                <input type='checkbox' name='optionTourGuide' value='yes' class='w-5 h-5 text-primary rounded focus:ring-primary' />
                <span class='text-sm font-medium text-ui-ink' title='Le chauffeur dispose d&apos;une accréditation guide touristique.'>Guide touristique</span>
              </label>
            </div>
          </div>

          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Itinéraire et lieux à visiter</label>
            <textarea name='plannedItinerary' rows='3' placeholder={site.dispoPlaceholderItineraire} class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary' required></textarea>
          </div>

          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Notes spéciales (optionnel)</label>
            <textarea name='specialNotes' rows='3' placeholder='Ex: Personne à mobilité réduite, besoins spécifiques...' class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary'></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Étape 4: Coordonnées -->
    <ContactStep stepNumber={4} />
  </form>
</TunnelLayout>

<script>
  import { TunnelManager } from '../../core/tunnel-core';
  import { supabase } from '../../core/supabase';

  const HEURE = 3600 * 1000;

  function initTunnel() {
    const dataDiv = document.getElementById('tunnel-data');
    if (!dataDiv) return;
    const tenantId = dataDiv.dataset.tenantId || '';
    const message = document.getElementById('tunnel-message');
    const show = (text: string) => { if (message) message.textContent = text; };

    const periode = (formData: FormData) => ({
      debut: new Date(`${formData.get('serviceDate')}T${formData.get('startTime')}`),
      fin: new Date(`${formData.get('endDate')}T${formData.get('endTime')}`),
    });

    const manager = new TunnelManager('tunnel-form', {
      maxSteps: 4,
      onValidateStep: (stepIndex, formData) => {
        show('');
        if (stepIndex === 1) {
          if (!formData.get('serviceDate') || !formData.get('startTime') || !formData.get('endDate') || !formData.get('endTime') || !formData.get('initialPickup')) {
            show('Veuillez indiquer le début, la fin et le lieu de prise en charge.'); return false;
          }
          const { debut, fin } = periode(formData);
          if (debut.getTime() < Date.now() + 2 * HEURE) { show('Le début doit être dans au moins 2 heures.'); return false; }
          if (fin <= debut) { show('La fin doit être après le début.'); return false; }
          const heures = (fin.getTime() - debut.getTime()) / HEURE;
          if (heures < 1) { show('La durée minimale est de 1 heure.'); return false; }
          if (heures > 8760) { show('La durée maximale est d\'un an.'); return false; }
        }
        if (stepIndex === 2 && !formData.get('vehicle')) { show('Veuillez choisir un véhicule.'); return false; }
        if (stepIndex === 4) {
          if (!formData.get('firstName') || !formData.get('lastName') || !formData.get('email') || !formData.get('phone')) {
            show('Veuillez remplir vos coordonnées.'); return false;
          }
        }
        return true;
      },
      onSubmit: async (formData) => {
        manager.setLoading(true, 'Envoi de la demande...');

        const instructions = [];
        if (formData.get('plannedItinerary')) instructions.push(`Itinéraire : ${formData.get('plannedItinerary')}`);
        if (formData.get('optionTranslator')) instructions.push('Option : Traducteur/Interprète requise');
        if (formData.get('optionTourGuide')) instructions.push('Option : Guide Touristique requise');
        if (formData.get('specialNotes')) instructions.push(`Notes client : ${formData.get('specialNotes')}`);

        const { debut, fin } = periode(formData);
        const vehicleInput = document.querySelector('input[name="vehicle"]:checked') as HTMLInputElement | null;

        const { error } = await supabase.rpc('submit_booking_request', {
          p_tenant_id: tenantId,
          p_request_kind: 'mise_a_disposition',
          p_pickup: String(formData.get('initialPickup') || ''),
          p_dropoff: '',
          p_pickup_time: debut.toISOString(),
          p_end_time: fin.toISOString(),
          p_passenger_count: Number(formData.get('passengerCount') || 1),
          p_luggage_count: 0,
          p_vehicle_id: vehicleInput?.dataset.id || null,
          p_first_name: String(formData.get('firstName') || ''),
          p_last_name: String(formData.get('lastName') || ''),
          p_email: String(formData.get('email') || ''),
          p_phone: String(formData.get('phone') || ''),
          p_instructions: instructions.join(' | ').slice(0, 500),
        });

        if (error) {
          show(error.message || "Erreur lors de l'envoi de la demande.");
          manager.setLoading(false);
          return;
        }
        manager.form?.replaceChildren(document.createTextNode('Demande envoyée. Vous recevrez un devis par e-mail.'));
        manager.form?.classList.add('text-ui-ink', 'text-center', 'py-12');
        if (manager.submitBtn) manager.submitBtn.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTunnel);
  } else {
    initTunnel();
  }
</script>

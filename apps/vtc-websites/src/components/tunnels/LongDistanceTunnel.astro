---
// src/components/tunnels/LongDistanceTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';
import ContactStep from './steps/ContactStep.astro';
import VehicleGridStep from './steps/VehicleGridStep.astro';
import { supabase } from '../../core/supabase';
import { configDuSite } from '../../core/site-config';
import DateTimePicker from './steps/DateTimePicker.astro';

const { tenant } = Astro.locals;
const site = configDuSite(Astro.url.host);
const tenantId = tenant?.id || "";

// Véhicules du tenant ; le prix est fixé par le chauffeur et communiqué par devis
const { data: vehiclesData } = await supabase.rpc('get_available_vehicles', { p_tenant_id: tenantId });
const availableVehicles = vehiclesData || [];

const vehicleTypes = availableVehicles.map((v: any) => ({
  type: v.category,
  id: v.id,
  name: `${v.brand} ${v.model}`,
  seats: v.capacity,
  price: 'Sur devis',
  icon: v.category.toLowerCase().includes('van') ? 'ri:bus-2-line' : (v.category.toLowerCase().includes('business') ? 'ri:briefcase-line' : 'ri:car-line')
}));

const serviceOptions = [
  { id: 'oneway', name: 'Trajet simple', desc: 'Aller simple sans retour' },
  { id: 'roundtrip', name: 'Aller-retour', desc: 'Trajet aller et retour le même jour' },
  { id: 'multiday', name: 'Plusieurs jours', desc: 'Chauffeur à disposition sur plusieurs jours' },
];

const { ...props } = Astro.props;
---

<TunnelLayout currentStep={1} totalSteps={4} serviceType='longDistance' {...props}>
  <div id="tunnel-data" data-tenant-id={tenantId} class="hidden"></div>
  <form id='tunnel-form' class='max-w-4xl mx-auto' novalidate>
    
    <!-- Étape 1: Destination & Service -->
    <div class='step-container' data-step='1'>
      <div class='mb-6'>
        <h2 class='text-2xl font-bold text-ui-ink mb-1'>Destination principale</h2>
        <p class='text-ui-muted mb-5'>Sélectionnez votre destination ou entrez une ville personnalisée</p>

        {site.longueDistanceDestinations.length > 0 && (
        <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4'>
          {
            site.longueDistanceDestinations.map((dest) => (
              <label class='relative group cursor-pointer'>
                <input type='radio' name='destination' value={dest.ville} data-distance={dest.distanceKm} class='sr-only peer' />
                <div class='p-4 border-2 border-ui-line rounded-xl hover:border-primary transition-all duration-300 peer-checked:border-primary peer-checked:bg-primary/5 h-full'>
                  <div class='flex items-start justify-between mb-4'>
                    <div>
                      <div class='text-lg font-semibold text-ui-ink'>{dest.ville}</div>
                      <div class='text-sm text-ui-muted mt-1'>
                        {dest.distanceKm} km • {dest.duree}
                      </div>
                    </div>
                    <!-- On cache le prix ici, on l'affichera à l'étape véhicule selon la gamme choisie -->
                  </div>
                  <div class='flex items-center gap-2 text-sm text-ui-muted'>
                    <Icon name='ri:road-map-line' class='text-sm' />
                    {site.longueDistanceVilleDepart && <span>Depuis {site.longueDistanceVilleDepart}</span>}
                  </div>
                </div>
                <div class='absolute top-4 right-4 w-6 h-6 border-2 border-ui-line-strong rounded-full peer-checked:border-primary peer-checked:bg-primary flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                  <Icon name='ri:check-line' class='text-white text-xs' />
                </div>
              </label>
            ))
          }
        </div>
        )}

        <div class="mb-6">
          <label class='block text-sm font-medium text-ui-ink mb-1.5'>{site.longueDistanceDestinations.length > 0 ? 'Ou entrez une destination personnalisée (Prix Sur Devis)' : 'Destination (prix sur devis)'}</label>
          <input
            type='text'
            name='customDestination'
            id='customDestination'
            placeholder={site.longueDistancePlaceholderDestination}
            required={site.longueDistanceDestinations.length === 0}
            class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary'
          />
        </div>

        <h2 class='text-2xl font-bold text-ui-ink mb-1'>Type de service</h2>
        <p class='text-ui-muted mb-5'>Choisissez la formule qui correspond à vos besoins</p>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          {
            serviceOptions.map((option) => (
              <label class='relative group cursor-pointer'>
                <input type='radio' name='serviceType' value={option.id} class='sr-only peer' required />
                <div class='p-4 border-2 border-ui-line rounded-xl hover:border-primary transition-all duration-300 peer-checked:border-primary peer-checked:bg-primary/5 h-full'>
                  <div class='w-12 h-12 rounded-lg bg-ui-page flex items-center justify-center mb-4 group-hover:bg-primary/10 transition-colors'>
                    <Icon name='ri:route-line' class='text-xl text-ui-muted group-hover:text-primary' />
                  </div>
                  <h3 class='text-lg font-semibold text-ui-ink mb-2'>{option.name}</h3>
                  <p class='text-sm text-ui-muted mb-4'>{option.desc}</p>
                </div>
                <div class='absolute top-4 right-4 w-6 h-6 border-2 border-ui-line-strong rounded-full peer-checked:border-primary peer-checked:bg-primary flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all'>
                  <Icon name='ri:check-line' class='text-white text-xs' />
                </div>
              </label>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Étape 2: Véhicule -->
    <VehicleGridStep 
      stepNumber={2} 
      vehicleTypes={vehicleTypes} 
      title="Choisissez votre véhicule"
      subtitle="Sélectionnez la gamme pour votre trajet. Le prix vous est communiqué par devis."
    />

    <!-- Étape 3: Dates et compléments -->
    <div class='step-container hidden' data-step='3'>
      <div class='mb-6'>
        <h2 class='text-2xl font-bold text-ui-ink mb-1'>Détails du trajet</h2>
        <p class='text-ui-muted mb-5'>Précisez les dates et informations de départ</p>

        <DateTimePicker
          class='mb-8'
          dateName='departureDate'
          timeName='departureTime'
          dateLabel='Date de départ'
          timeLabel='Heure de départ'
        />

        <div class='space-y-6'>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Nombre de passagers</label>
            <select name='passengerCount' class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary' required>
              <option value='1'>1 passager</option>
              <option value='2'>2 passagers</option>
              <option value='3'>3 passagers</option>
              <option value='4'>4 passagers</option>
              <option value='5'>5 passagers</option>
              <option value='6'>6 passagers</option>
            </select>
          </div>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Adresse exacte de prise en charge{site.longueDistanceVilleDepart ? ` (${site.longueDistanceVilleDepart})` : ''}</label>
            <input type='text' name='pickupAddress' placeholder={site.longueDistancePlaceholderDepart} class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary' required />
          </div>
          <div id="customDropoffContainer" class="hidden">
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Adresse exacte de destination</label>
            <input type='text' name='destinationAddress' placeholder='Ex: Adresse complète de destination' class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary' />
          </div>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Notes spéciales (optionnel)</label>
            <textarea name='specialNotes' rows='3' placeholder='Ex: Arrêt prévu à mi-parcours, besoins particuliers...' class='w-full px-4 py-2.5 border border-ui-line-strong rounded-lg focus:ring-2 focus:ring-primary focus:border-primary'></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Étape 4: Coordonnées -->
    <ContactStep stepNumber={4} />
  </form>
</TunnelLayout>

<script>
  import { TunnelManager } from '../../core/tunnel-core';
  import { supabase } from '../../core/supabase';

  function initTunnel() {
    const dataDiv = document.getElementById('tunnel-data');
    if (!dataDiv) return;
    const tenantId = dataDiv.dataset.tenantId || '';
    const message = document.getElementById('tunnel-message');
    const show = (text: string) => { if (message) message.textContent = text; };

    const customDestInput = document.getElementById('customDestination') as HTMLInputElement;
    const customDropoffContainer = document.getElementById('customDropoffContainer');
    const destInputs = document.querySelectorAll('input[name="destination"]');

    customDestInput?.addEventListener('input', () => {
      if (customDestInput.value.trim() !== '') {
        destInputs.forEach(r => (r as HTMLInputElement).checked = false);
      }
    });

    destInputs.forEach(radio => {
      radio.addEventListener('change', () => {
        if ((radio as HTMLInputElement).checked) customDestInput.value = '';
      });
    });

    const manager = new TunnelManager('tunnel-form', {
      maxSteps: 4,
      onValidateStep: (stepIndex, formData) => {
        show('');
        if (stepIndex === 1) {
          if (!formData.get('destination') && customDestInput.value.trim() === '') {
            show('Veuillez sélectionner ou entrer une destination.'); return false;
          }
          if (!formData.get('serviceType')) {
            show('Veuillez choisir un type de service.'); return false;
          }
          if (customDropoffContainer) {
            if (customDestInput.value.trim() !== '') customDropoffContainer.classList.remove('hidden');
            else customDropoffContainer.classList.add('hidden');
          }
        }

        if (stepIndex === 2 && !formData.get('vehicle')) { show('Veuillez choisir un véhicule.'); return false; }

        if (stepIndex === 3) {
          if (!formData.get('departureDate') || !formData.get('departureTime') || !formData.get('pickupAddress')) {
            show('Veuillez remplir les informations de départ.'); return false;
          }
        }

        if (stepIndex === 4) {
          if (!formData.get('firstName') || !formData.get('lastName') || !formData.get('email') || !formData.get('phone')) {
            show('Veuillez remplir vos coordonnées.'); return false;
          }
        }
        return true;
      },
      onSubmit: async (formData) => {
        manager.setLoading(true, 'Envoi de la demande...');

        const custom = customDestInput.value.trim();
        const destination = custom || String(formData.get('destination') || '');
        const precise = String(formData.get('destinationAddress') || '');
        const formule = { oneway: 'Trajet simple', roundtrip: 'Aller-retour', multiday: 'Plusieurs jours' }[String(formData.get('serviceType'))] || '';
        const instructions = [];
        if (formule) instructions.push(`Formule : ${formule}`);
        if (precise) instructions.push(`Adresse de destination : ${precise}`);
        if (formData.get('specialNotes')) instructions.push(`Notes client : ${formData.get('specialNotes')}`);

        const vehicleInput = document.querySelector('input[name="vehicle"]:checked') as HTMLInputElement | null;

        const { error } = await supabase.rpc('submit_booking_request', {
          p_tenant_id: tenantId,
          p_request_kind: 'longue_distance',
          p_pickup: String(formData.get('pickupAddress') || ''),
          p_dropoff: destination,
          p_pickup_time: new Date(`${formData.get('departureDate')}T${formData.get('departureTime')}`).toISOString(),
          p_end_time: null,
          p_passenger_count: Number(formData.get('passengerCount') || 1),
          p_luggage_count: 0,
          p_vehicle_id: vehicleInput?.dataset.id || null,
          p_first_name: String(formData.get('firstName') || ''),
          p_last_name: String(formData.get('lastName') || ''),
          p_email: String(formData.get('email') || ''),
          p_phone: String(formData.get('phone') || ''),
          p_instructions: instructions.join(' | ').slice(0, 500),
        });

        if (error) {
          show(error.message || "Erreur lors de l'envoi de la demande.");
          manager.setLoading(false);
          return;
        }
        manager.form?.replaceChildren(document.createTextNode('Demande envoyée. Vous recevrez un devis par e-mail.'));
        manager.form?.classList.add('text-ui-ink', 'text-center', 'py-12');
        if (manager.submitBtn) manager.submitBtn.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTunnel);
  } else {
    initTunnel();
  }
</script>

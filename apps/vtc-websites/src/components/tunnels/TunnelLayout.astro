---
// src/components/tunnels/TunnelLayout.astro
import { configDuSite } from '../../core/site-config';
import TunnelProgress from './TunnelProgress.astro';
import TunnelFooter from './TunnelFooter.astro';
import { Icon } from 'astro-icon/components';

const {
  currentStep = 1,
  totalSteps = 4,
  serviceType = 'airport',
  title: propTitle,
  icon: propIcon,
} = Astro.props;

const tenant = Astro.locals.tenant || { name: configDuSite(Astro.url.host).nom, id: '' };

// Fallback configs si les props ne sont pas fournies
const defaultConfigs = {
  airport: { title: 'Transfert', icon: 'ri:route-line' },
  transfert: { title: 'Transfert', icon: 'ri:route-line' },
  longDistance: { title: 'Longue Distance', icon: 'ri:road-map-line' },
  business: { title: 'Business & B2B', icon: 'ri:briefcase-line' },
  availability: { title: 'Mise à Disposition', icon: 'ri:time-line' },
};

const defaultConfig =
  defaultConfigs[serviceType as keyof typeof defaultConfigs] || defaultConfigs.airport;

const config = {
  title: propTitle || defaultConfig.title,
  icon: propIcon || defaultConfig.icon,
};
---

<div class='min-h-screen bg-ui-page overflow-x-hidden text-ui-ink relative'>
  <!-- Header avec progression -->
  <header class='fixed top-0 left-0 right-0 w-full z-50 bg-ui-card border-b border-ui-line'>
    <div class='container mx-auto px-6 py-3 md:py-4'>
      <div class='flex items-center justify-between'>
        <a href='/' class='text-xl font-bold text-ui-ink hover:text-primary transition-colors'>
          {tenant.name}
        </a>
        <div class='flex items-center gap-4 md:gap-6'>
          <div class="flex items-center gap-3">
            <span class='text-sm font-medium text-ui-muted hidden sm:inline'>
              {config.title}
            </span>
            <div
              class={`w-8 h-8 rounded-full flex items-center justify-center bg-ui-ink text-white`}>
              <Icon name={config.icon} class='text-lg' />
            </div>
          </div>
          
          <div class="h-6 w-px bg-ui-line"></div>
          
          <!-- Bouton Fermer le tunnel (retour accueil) -->
          <a href="/" class="flex items-center gap-2 text-sm font-medium text-ui-muted hover:text-ui-ink transition-colors group">
            <span class="hidden sm:inline">Quitter</span>
            <div class="w-8 h-8 rounded-full bg-ui-page flex items-center justify-center group-hover:bg-ui-line transition-colors">
              <Icon name='ri:close-line' class='text-lg' />
            </div>
          </a>
        </div>
      </div>

      <!-- Barre de progression -->
      <div class='mt-4 md:mt-6'>
        <TunnelProgress currentStep={currentStep} totalSteps={totalSteps} />
      </div>
    </div>
  </header>

  <!-- Contenu principal -->
  <main class='container mx-auto px-6 pt-36 md:pt-40 pb-12'>
    <slot />
  </main>

  <!-- Footer avec navigation (extrait dans un composant) -->
  <TunnelFooter currentStep={currentStep} totalSteps={totalSteps} />
</div>

<!-- Scripts & Styles de Flatpickr pour un calendrier Premium et Homogène -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style is:global>
  /* Flatpickr aux couleurs des tokens du site */
  .flatpickr-calendar {
    background: var(--color-ui-card) !important;
    border: 1px solid var(--color-ui-line) !important;
    border-radius: 12px !important;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1) !important;
    font-family: inherit !important;
  }
  .flatpickr-day.selected, 
  .flatpickr-day.selected:hover, 
  .flatpickr-day.selected:focus {
    background: var(--color-ui-ink) !important;
    border-color: var(--color-ui-ink) !important;
    color: var(--color-ui-card) !important;
  }
  .flatpickr-months .flatpickr-month {
    color: var(--color-ui-ink) !important;
    fill: var(--color-ui-ink) !important;
  }
  .flatpickr-current-month .numInputWrapper span.arrowUp:after {
    border-bottom-color: var(--color-ui-ink) !important;
  }
  .flatpickr-current-month .numInputWrapper span.arrowDown:after {
    border-top-color: var(--color-ui-ink) !important;
  }
  .flatpickr-calendar.hasTime .flatpickr-time {
    border-top: 1px solid var(--color-ui-line) !important;
  }
  /* Cacher l'input original alternatif généré par Flatpickr (altInput) */
  .flatpickr-input[type="hidden"] {
    display: none !important;
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

<script is:inline>
  function initFlatpickr() {
    const dateInputs = document.querySelectorAll('.js-fp-date');
    const timeInputs = document.querySelectorAll('.js-fp-time');

    dateInputs.forEach((dateInput) => {
      flatpickr(dateInput, {
        locale: 'fr',
        dateFormat: 'Y-m-d',
        altInput: true,
        altFormat: 'd F Y',
        minDate: 'today',
        disableMobile: true // Force le superbe calendrier Flatpickr au lieu du sélecteur OS natif buggé
      });
    });

    timeInputs.forEach((timeInput) => {
      flatpickr(timeInput, {
        locale: 'fr',
        enableTime: true,
        noCalendar: true,
        dateFormat: 'H:i',
        time_24hr: true,
        disableMobile: true
      });
    });
  }

  // Initialisation à chaque chargement de page
  document.addEventListener('DOMContentLoaded', initFlatpickr);
  document.addEventListener('astro:page-load', initFlatpickr);
</script>

---
// apps/drivers-front/src/components/tunnels/steps/ContactStep.astro

interface Props {
  stepNumber: number;
  isBusinessOnly?: boolean;
  withInstructions?: boolean;
}

const { stepNumber, isBusinessOnly = false, withInstructions = false } = Astro.props;

const ringClass = 'focus:ring-primary';
const checkboxColor = 'text-primary focus:ring-primary';
---

<div class='step-container hidden' data-step={stepNumber}>
  <div class='mt-2'>
    <h2 class='text-2xl font-bold text-ui-ink mb-1'>{isBusinessOnly ? "Informations entreprise" : "Vos coordonnées"}</h2>
    <p class='text-ui-muted mb-5'>{isBusinessOnly ? "Renseignez les informations de facturation de votre société" : "Dernière étape avant la confirmation"}</p>

    <div class='grid grid-cols-1 md:grid-cols-2 gap-4 mb-4'>
      <div>
        <label class='block text-sm font-medium text-ui-ink mb-1.5'>Prénom</label>
        <input type='text' name='firstName' placeholder='Votre prénom' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} required />
      </div>
      <div>
        <label class='block text-sm font-medium text-ui-ink mb-1.5'>Nom</label>
        <input type='text' name='lastName' placeholder='Votre nom' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} required />
      </div>
    </div>
    <div class='grid grid-cols-1 md:grid-cols-2 gap-4 mb-4'>
      <div>
        <label class='block text-sm font-medium text-ui-ink mb-1.5'>Email</label>
        <input type='email' name='email' placeholder='votre@email.com' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} required />
      </div>
      <div>
        <label class='block text-sm font-medium text-ui-ink mb-1.5'>Téléphone</label>
        <input type='tel' name='phone' placeholder='Votre numéro de téléphone' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} required />
      </div>
    </div>

    {withInstructions && (
      <div class='mb-6'>
        <label class='block text-sm font-medium text-ui-ink mb-1.5'>Instructions (facultatif)</label>
        <textarea name='instructions' rows='2' maxlength='500' placeholder="N° de vol, panneau d'accueil, bagages…" class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`}></textarea>
      </div>
    )}

    {isBusinessOnly ? (
      <div class='space-y-6'>
        <div>
          <label class='block text-sm font-medium text-ui-ink mb-1.5'>Nom de l'entreprise</label>
          <input type='text' name='companyName' placeholder='Ex: Société Example SAS' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} required />
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>SIRET</label>
            <input type='text' name='siret' placeholder='Ex: 123 456 789 00012' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} />
          </div>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>TVA Intracommunautaire</label>
            <input type='text' name='vatNumber' placeholder='Ex: FR12345678901' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} />
          </div>
        </div>

        <div>
          <label class='block text-sm font-medium text-ui-ink mb-1.5'>Adresse de facturation</label>
          <textarea name='billingAddress' rows={2} placeholder='Adresse complète de facturation' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} required></textarea>
        </div>
      </div>
    ) : (
      <div class='mt-6 border-t border-ui-line pt-6'>
        <label class='flex items-center gap-3 cursor-pointer mb-4'>
          <input type='checkbox' name='isCompany' value='yes' class={`is-company-checkbox w-5 h-5 rounded ${checkboxColor}`} />
          <span class='text-sm font-medium text-ui-ink'>Je réserve pour une entreprise (Facture Pro / Devis)</span>
        </label>
        
        <div class='company-fields-container hidden space-y-4'>
          <div>
            <label class='block text-sm font-medium text-ui-ink mb-1.5'>Nom de l'entreprise</label>
            <input type='text' name='companyName' placeholder='Nom de la société' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} />
          </div>
          <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
            <div>
              <label class='block text-sm font-medium text-ui-ink mb-1.5'>SIRET (Optionnel)</label>
              <input type='text' name='siret' placeholder='N° SIRET' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} />
            </div>
            <div>
              <label class='block text-sm font-medium text-ui-ink mb-1.5'>TVA Intracommunautaire (Optionnel)</label>
              <input type='text' name='vatNumber' placeholder='N° TVA' class={`w-full px-4 py-2.5 bg-ui-card text-ui-ink border border-ui-line-strong rounded-lg focus:ring-2 ${ringClass} focus:border-primary`} />
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</div>

<script>
  function initContactStep() {
    const checkboxes = document.querySelectorAll('.is-company-checkbox');
    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const container = target.closest('.step-container')?.querySelector('.company-fields-container');
        if (container) {
          if (target.checked) {
            container.classList.remove('hidden');
          } else {
            container.classList.add('hidden');
          }
        }
      });
    });
  }

  // Execute on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactStep);
  } else {
    initContactStep();
  }
</script>

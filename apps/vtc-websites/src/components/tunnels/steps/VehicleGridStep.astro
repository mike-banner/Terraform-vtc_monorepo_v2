---
// apps/drivers-front/src/components/tunnels/steps/VehicleGridStep.astro
import { Icon } from 'astro-icon/components';

interface Props {
  stepNumber: number;
  vehicleTypes: any[];
  title?: string;
  subtitle?: string;
  showEstimationNote?: boolean;
  estimationNoteText?: string;
}

const { 
  stepNumber, 
  vehicleTypes,
  title = "Choisissez votre véhicule",
  subtitle = "Sélectionnez la gamme qui vous convient.",
  showEstimationNote = false,
  estimationNoteText = ""
} = Astro.props;

const borderColor = 'peer-checked:border-primary hover:border-primary';
const bgColor = 'peer-checked:bg-primary/5';
const iconHoverBg = 'group-hover:bg-primary/10';
const iconHoverText = 'group-hover:text-primary';
const priceColor = 'text-primary';
const checkBg = 'peer-checked:bg-primary';
---

<div class='step-container hidden' data-step={stepNumber}>
  <div class='mb-12'>
    <h2 class='text-2xl font-bold text-ui-ink mb-2'>{title}</h2>
    <p class='text-ui-muted mb-8'>{subtitle}</p>

    {showEstimationNote && (
      <p id="estimationNote" class="text-xs text-ui-wait font-medium mb-6 bg-ui-wait-soft p-3 rounded-lg hidden">
        {estimationNoteText}
      </p>
    )}

    <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
      {
        vehicleTypes.map((vehicle: any) => (
          <label class='relative group cursor-pointer'>
            <input type='radio' name='vehicle' value={vehicle.type} data-id={vehicle.id} class='sr-only peer' required />
            <div class={`peer-focus-visible:ring-2 peer-focus-visible:ring-primary p-6 border-2 border-ui-line rounded-xl transition-all duration-300 h-full ${borderColor} ${bgColor}`}>
              <div class={`w-12 h-12 rounded-lg bg-ui-page flex items-center justify-center mb-4 transition-colors ${iconHoverBg}`}>
                <Icon name={vehicle.icon} class={`text-xl text-ui-muted ${iconHoverText}`} />
              </div>
              <h3 class='text-lg font-semibold text-ui-ink mb-2'>{vehicle.name}</h3>
              <div class='space-y-2 mb-4'>
                <div class='flex items-center gap-2 text-sm text-ui-muted'>
                  <Icon name='ri:user-line' class='text-sm' />
                  <span>{vehicle.seats} passagers maximum</span>
                </div>
              </div>
              <div class={`text-lg font-bold mt-4 price-display ${priceColor}`}>{vehicle.price}</div>
            </div>
            <div class={`absolute top-4 right-4 w-6 h-6 border-2 border-ui-line-strong rounded-full flex items-center justify-center opacity-0 peer-checked:opacity-100 transition-all ${borderColor} ${checkBg}`}>
              <Icon name='ri:check-line' class='text-white text-xs' />
            </div>
          </label>
        ))
      }
    </div>
  </div>
</div>

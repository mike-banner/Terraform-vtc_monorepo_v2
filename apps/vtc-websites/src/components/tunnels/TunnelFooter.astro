---
// src/components/tunnels/TunnelFooter.astro
import { Icon } from 'astro-icon/components';

export interface Props {
  currentStep?: number;
  totalSteps?: number;
}

const { currentStep = 1, totalSteps = 4 } = Astro.props;
---

<footer class='border-t border-ui-line bg-ui-card mt-auto'>
  <div class='container mx-auto px-4 sm:px-6 py-6 sm:py-8'>
    <div class='flex justify-between items-center'>
      <div class="flex items-center gap-4 sm:gap-6">
        <!-- Spacer si besoin pour équilibrer, mais ici flex-between se calera sur le premier élément -->
        
        <!-- Bouton Précédent (géré par JS dynamique) -->
        <button
          id="back-btn"
          type="button"
          class='text-ui-muted hover:text-ui-ink focus-visible:ring-2 focus-visible:ring-primary rounded-md font-medium flex items-center gap-1.5 sm:gap-2 hidden transition-colors'>
          <Icon name='ri:arrow-left-line' class='text-lg' />
          Précédent
        </button>
      </div>

      <div class='flex items-center gap-4'>
        <span id="progress-text" class='text-sm text-ui-muted hidden sm:inline font-medium'>
          Étape <span id="current-step-text">{currentStep}</span> sur {totalSteps}
        </span>
        <button
          id="submit-btn"
          type='submit'
          form='tunnel-form'
          class='bg-ui-ink text-white px-6 sm:px-8 py-3 font-semibold rounded-xl hover:bg-ui-ink/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors flex items-center gap-2'>
          <span id="submit-btn-text">{currentStep === totalSteps ? 'Finaliser' : 'Continuer'}</span>
          <Icon name='ri:arrow-right-line' class='text-lg' id="submit-btn-icon" />
        </button>
      </div>
    </div>
  </div>
</footer>

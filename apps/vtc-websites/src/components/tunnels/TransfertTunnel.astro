---
// src/components/tunnels/TransfertTunnel.astro
import { Icon } from 'astro-icon/components';
import TunnelLayout from './TunnelLayout.astro';
import InlineError from '../ui/InlineError.astro';
import ContactStep from './steps/ContactStep.astro';
import VehicleGridStep from './steps/VehicleGridStep.astro';
import { supabase } from '../../core/supabase';

const { tenant } = Astro.locals;
const tenantId = tenant?.id || "";

// 1 & 2. Récupération des données en parallèle pour accélérer le chargement SSR
const [
  { data: vehiclesData },
  { data: fixedRoutesData }
] = await Promise.all([
  supabase.rpc('get_available_vehicles', { p_tenant_id: tenantId }),
  supabase
    .from('fixed_routes')
    .select('*, pickup_zone:pickup_zone_id(name), dropoff_zone:dropoff_zone_id(name)')
    .eq('tenant_id', tenantId)
    .eq('active', true)
]);

const availableVehicles = vehiclesData || [];

const vehicleTypes = availableVehicles.map((v: any) => ({
  type: v.category,
  id: v.id,
  name: `${v.brand} ${v.model}`,
  seats: v.capacity,
  price: 'Sur devis', // Calculé dynamiquement au clic
  icon: v.category.toLowerCase().includes('van') ? 'ri:bus-2-line' : (v.category.toLowerCase().includes('business') ? 'ri:briefcase-line' : 'ri:car-line')
}));

const uniqueRoutesMap = new Map();
fixedRoutesData?.forEach((route: any) => {
  const pickup = route.pickup_zone?.name;
  const dropoff = route.dropoff_zone?.name;
  if (!pickup || !dropoff) return;
  const key = `${pickup}-${dropoff}`;
  if (!uniqueRoutesMap.has(key)) {
    uniqueRoutesMap.set(key, {
      code: pickup.substring(0, 3).toUpperCase(),
      name: `${pickup} ↔ ${dropoff}`,
      distance: 'Transfert Fixe',
      pickup,
      dropoff,
      minPrice: route.price || 0
    });
  } else {
    const existing = uniqueRoutesMap.get(key);
    if (route.price && route.price < existing.minPrice) {
      existing.minPrice = route.price;
    }
  }
});
const destinations = Array.from(uniqueRoutesMap.values());

const { serviceType = 'airport', ...props } = Astro.props;
const isGeneralTransfer = serviceType === 'transfert';
---

<TunnelLayout currentStep={1} totalSteps={4} serviceType={serviceType} {...props}>
  <div id="tunnel-data" data-tenant-id={tenantId} data-routes={JSON.stringify(fixedRoutesData)} class="hidden"></div>
  <form id='tunnel-form' class='max-w-4xl mx-auto' novalidate>
    <!-- Étape 1: Sélection transfert/aéroport -->
    <div class='step-container' data-step='1'>
      <div class='mb-12'>
        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>
          Sélectionnez votre trajet
        </h2>
        <p class='text-zinc-600 mb-8'>
          Choisissez le forfait fixe et le sens du trajet.
        </p>

        <div class='mb-8'>
          <label class='block text-sm font-medium text-zinc-700 mb-2'>Liaison disponible</label>
          <select name='routeSelect' id='routeSelect' class='w-full px-4 py-4 border-2 border-zinc-200 rounded-xl focus:ring-2 focus:ring-accent focus:border-accent bg-white text-zinc-900 font-medium text-lg' required>
            <option value='' disabled selected>Sélectionnez un trajet...</option>
            {destinations.map(dest => (
              <option value={`${dest.pickup}|${dest.dropoff}`} data-min-price={dest.minPrice}>
                {dest.name} (à partir de {dest.minPrice} €)
              </option>
            ))}
          </select>
        </div>

        <!-- Visuel Départ / Arrivée + Bouton Swap -->
        <div id="directionDisplayContainer" class="hidden mb-8">
          <div class="flex items-center justify-between p-4 bg-white border-2 border-zinc-200 rounded-xl">
            <div class="flex-1 text-center">
              <div class="text-xs text-zinc-500 uppercase tracking-wider font-semibold mb-1">Départ</div>
              <div id="displayPickup" class="font-bold text-zinc-900 text-lg sm:text-xl">---</div>
            </div>
            
            <button type="button" id="swapDirectionBtn" class="w-12 h-12 rounded-full bg-zinc-50 border border-zinc-200 shadow-sm flex flex-col items-center justify-center text-zinc-600 hover:text-accent hover:border-accent transition-all shrink-0 mx-2 sm:mx-4 group relative">
              <Icon name="ri:arrow-left-right-line" class="text-xl group-hover:rotate-180 transition-transform duration-300" />
            </button>
            
            <div class="flex-1 text-center">
              <div class="text-xs text-zinc-500 uppercase tracking-wider font-semibold mb-1">Arrivée</div>
              <div id="displayDropoff" class="font-bold text-zinc-900 text-lg sm:text-xl">---</div>
            </div>
          </div>
          <input type="hidden" name="direction" id="directionState" value="forward" />
        </div>

        <div id="addressFieldsContainer" class="hidden space-y-6 p-6 bg-zinc-50 border border-zinc-200 rounded-xl">
          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6 text-sm text-blue-700 hidden" id="parisAlert">
            <p class="font-bold">Information importante :</p>
            <p>L'adresse dans Paris doit obligatoirement inclure un code postal valide (ex: <span class="font-bold">75001</span>).</p>
          </div>
          <div>
            <label id="pickupLabel" class='block text-sm font-medium text-zinc-700 mb-2'>Adresse de départ</label>
            <input type='text' name='pickupAddress' id='pickupAddress' class='w-full px-4 py-3 bg-white text-zinc-900 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent' required />
            <InlineError id="pickupError" />
          </div>
          <div>
            <label id="dropoffLabel" class='block text-sm font-medium text-zinc-700 mb-2'>Adresse d'arrivée</label>
            <input type='text' name='dropoffAddress' id='dropoffAddress' class='w-full px-4 py-3 bg-white text-zinc-900 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent' required />
            <InlineError id="dropoffError" />
          </div>
          <div id="flightTrackingContainer" class="hidden mt-4 pt-4 border-t border-zinc-200">
            <label class='flex items-center gap-3 cursor-pointer'>
              <input type='checkbox' name='flightTracking' class='w-5 h-5 text-accent rounded focus:ring-accent' />
              <span class='text-sm text-zinc-700'>Activer le suivi de vol/train (ajustement de l'heure en cas de retard)</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Étape 2: Type de véhicule -->
    <VehicleGridStep 
      stepNumber={2} 
      themeColor="accent" 
      vehicleTypes={vehicleTypes} 
      title="Choisissez votre véhicule"
      subtitle="Sélectionnez le type de véhicule adapté à vos besoins"
    />

    <!-- Étape 3: Date et heure -->
    <div class='step-container hidden' data-step='3'>
      <div class='mb-12'>
        <h2 class='text-2xl font-bold text-zinc-900 mb-2'>Date et heure du transfert</h2>
        <p class='text-zinc-600 mb-8'>Précisez la date et l'heure de votre trajet</p>

        <div class='grid grid-cols-2 gap-4 max-w-md'>
          <div>
            <label class='block text-xs font-semibold text-zinc-700 mb-1.5'>Date du trajet</label>
            <input
              type='text'
              name='date'
              id='flatpickr-date'
              placeholder='Choisir la date'
              class='w-full px-3 py-2.5 text-sm border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent bg-white text-zinc-900 cursor-pointer'
              required
            />
          </div>
          <div>
            <label class='block text-xs font-semibold text-zinc-700 mb-1.5'>Heure du trajet</label>
            <input
              type='text'
              name='time'
              id='flatpickr-time'
              placeholder='Choisir l\'heure'
              class='w-full px-3 py-2.5 text-sm border border-zinc-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent bg-white text-zinc-900 cursor-pointer'
              required
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Fin Etape 3 -->


    
    <!-- Étape 4: Coordonnées -->
    <ContactStep stepNumber={4} themeColor="accent" />
  </form>
</TunnelLayout>

<script>
  import { supabase } from '../../core/supabase';
  import { TunnelManager } from '../../core/tunnel-core';
  
  function initTunnel() {
    const dataDiv = document.getElementById('tunnel-data');
    if (!dataDiv) return;

    const tenantId = dataDiv.dataset.tenantId;
    const routes = JSON.parse(dataDiv.dataset.routes || '[]');

    const routeSelect = document.getElementById('routeSelect') as HTMLSelectElement;
    const vehicleInputs = document.querySelectorAll('input[name="vehicle"]');
    const pickupInput = document.getElementById('pickupAddress') as HTMLInputElement;
    const dropoffInput = document.getElementById('dropoffAddress') as HTMLInputElement;
    const pickupLabel = document.getElementById('pickupLabel');
    const dropoffLabel = document.getElementById('dropoffLabel');
    const flightTrackingContainer = document.getElementById('flightTrackingContainer');
    const addressFieldsContainer = document.getElementById('addressFieldsContainer');
    const directionDisplayContainer = document.getElementById('directionDisplayContainer');
    const parisAlert = document.getElementById('parisAlert');
    
    const swapBtn = document.getElementById('swapDirectionBtn');
    const directionState = document.getElementById('directionState') as HTMLInputElement;
    const displayPickup = document.getElementById('displayPickup');
    const displayDropoff = document.getElementById('displayDropoff');

    const manager = new TunnelManager('tunnel-form', {
      maxSteps: 4,
      onStepChange: (stepIndex) => {
        if (stepIndex === 2) updatePriceDisplay();
      },
      onValidateStep: async (stepIndex, formData) => {
        // Cacher les erreurs précédentes
        const pickupError = document.getElementById('pickupError');
        const dropoffError = document.getElementById('dropoffError');
        if (pickupError) pickupError.classList.add('hidden');
        if (dropoffError) dropoffError.classList.add('hidden');

        if (stepIndex === 1) {
          if (!routeSelect.value) { alert("Veuillez sélectionner un trajet."); return false; }
          const pAddress = formData.get('pickupAddress') as string;
          const dAddress = formData.get('dropoffAddress') as string;
          if (!pAddress || !dAddress) { alert("Veuillez indiquer les adresses de départ et d'arrivée."); return false; }

          const [basePickup, baseDropoff] = routeSelect.value.split('|');
          const isForward = directionState.value === 'forward';
          const currentPickup = isForward ? basePickup : baseDropoff;
          const currentDropoff = isForward ? baseDropoff : basePickup;
          
          let hasError = false;
          const parisRegex = /75\d{3}/;
          if (currentPickup.toLowerCase().includes('paris') && !parisRegex.test(pAddress)) {
            if (pickupError) { pickupError.textContent = `Veuillez inclure un code postal parisien (ex: 75001).`; pickupError.classList.remove('hidden'); }
            hasError = true;
          }
          if (currentDropoff.toLowerCase().includes('paris') && !parisRegex.test(dAddress)) {
            if (dropoffError) { dropoffError.textContent = `Veuillez inclure un code postal parisien (ex: 75001).`; dropoffError.classList.remove('hidden'); }
            hasError = true;
          }
          if (hasError) return false;
        }

        if (stepIndex === 2 && !formData.get('vehicle')) { alert("Veuillez choisir un véhicule."); return false; }
        if (stepIndex === 3 && (!formData.get('date') || !formData.get('time'))) { alert("Veuillez préciser la date et l'heure."); return false; }

        if (stepIndex === 4) {
          if (!formData.get('firstName') || !formData.get('lastName') || !formData.get('email') || !formData.get('phone')) {
            alert("Veuillez remplir vos coordonnées."); return false;
          }
          if (!formData.get('vehicle')) { alert("Veuillez sélectionner un véhicule à l'étape 2."); return false; }
        }
        return true;
      },
      onSubmit: async (formData) => {
        const [pickupZone, dropoffZone] = routeSelect.value.split('|');
        const vehicle = formData.get('vehicle') as string;
        
        let route = routes.find((r: any) => 
          r.pickup_zone?.name === pickupZone && 
          r.dropoff_zone?.name === dropoffZone && 
          r.vehicle_category?.toLowerCase() === vehicle.toLowerCase()
        );

        if (!route) route = { id: 'mock-route-id', price: 50 };

        const selectedRadio = Array.from(vehicleInputs).find(r => (r as HTMLInputElement).checked) as HTMLInputElement;
        const vehicleId = selectedRadio ? selectedRadio.getAttribute('data-id') : null;

        manager.setLoading(true, 'Génération de la session...');

        try {
          const datetimeStr = `${formData.get('date')}T${formData.get('time')}:00`;
          const scheduledDate = new Date(datetimeStr).toISOString();

          const { data, error } = await supabase.functions.invoke("create_checkout_session", {
            body: {
              customer_data: {
                first_name: formData.get('firstName'),
                last_name: formData.get('lastName'),
                email: formData.get('email'),
                phone: formData.get('phone')
              },
              booking_data: {
                tenant_id: tenantId,
                type: 'standard',
                vehicle_id: vehicleId,
                fixed_route_id: route.id,
                pickup_address: formData.get('pickupAddress') || pickupZone,
                dropoff_address: formData.get('dropoffAddress') || dropoffZone,
                pickup_time: scheduledDate,
                passenger_count: 1,
                luggage_count: 0
              }
            }
          });

          if (error) throw error;
          if (data?.url) window.location.href = data.url;
          else throw new Error("Impossible de générer le lien de paiement Stripe.");
        } catch (err: any) {
          console.error("Checkout error:", err);
          alert(err.message || "Erreur lors de la création du paiement");
          manager.setLoading(false);
        }
      }
    });

    swapBtn?.addEventListener('click', () => {
      if (!routeSelect.value) return;
      directionState.value = directionState.value === 'forward' ? 'reverse' : 'forward';
      updateAddressLabels();
    });

    function updateAddressLabels() {
      if (!routeSelect.value) {
        addressFieldsContainer?.classList.add('hidden');
        directionDisplayContainer?.classList.add('hidden');
        return;
      }
      
      addressFieldsContainer?.classList.remove('hidden');
      directionDisplayContainer?.classList.remove('hidden');

      const [basePickup, baseDropoff] = routeSelect.value.split('|');
      const isForward = directionState.value === 'forward';
      const currentPickup = isForward ? basePickup : baseDropoff;
      const currentDropoff = isForward ? baseDropoff : basePickup;

      if (displayPickup) displayPickup.textContent = currentPickup;
      if (displayDropoff) displayDropoff.textContent = currentDropoff;

      const isParis = currentPickup.toLowerCase().includes('paris') || currentDropoff.toLowerCase().includes('paris');
      if (parisAlert) {
        if (isParis) parisAlert.classList.remove('hidden');
        else parisAlert.classList.add('hidden');
      }

      const isAirportPickup = currentPickup.toLowerCase().match(/aéroport|aeroport|cdg|ory|lys/);

      if (pickupLabel) pickupLabel.textContent = `Adresse exacte de départ (${currentPickup})`;
      if (dropoffLabel) dropoffLabel.textContent = `Adresse exacte d'arrivée (${currentDropoff})`;
      
      pickupInput.placeholder = isAirportPickup ? `Ex: Terminal 2E, Vol AF123` : (currentPickup.toLowerCase().includes('paris') ? 'Ex: 1 Rue de Rivoli, 75001 Paris' : 'Ex: Adresse complète');
      dropoffInput.placeholder = currentDropoff.toLowerCase().includes('paris') ? 'Ex: 1 Rue de Rivoli, 75001 Paris' : 'Ex: Adresse complète';

      if (flightTrackingContainer) {
        if (isAirportPickup) flightTrackingContainer.classList.remove('hidden');
        else flightTrackingContainer.classList.add('hidden');
      }
    }

    routeSelect.addEventListener('change', () => {
      directionState.value = 'forward';
      updatePriceDisplay();
      updateAddressLabels();
    });

    function updatePriceDisplay() {
      if (!routeSelect.value) return;
      const [basePickup, baseDropoff] = routeSelect.value.split('|');
      
      vehicleInputs.forEach((input) => {
        const radio = input as HTMLInputElement;
        const category = radio.value;
        const vehicleCard = radio.nextElementSibling as HTMLElement;
        if (!vehicleCard) return;
        const priceDiv = vehicleCard.querySelector('.text-lg.font-bold');
        
        const route = routes.find((r: any) => 
          r.pickup_zone?.name === basePickup && 
          r.dropoff_zone?.name === baseDropoff && 
          r.vehicle_category?.toLowerCase() === category.toLowerCase()
        );

        if (priceDiv) {
          if (route && route.price) {
            priceDiv.textContent = `${route.price} €`;
            priceDiv.classList.remove('text-amber-600', 'text-sm');
            priceDiv.classList.add('text-accent', 'text-lg');
          } else {
            priceDiv.textContent = `Sur devis`;
            priceDiv.classList.remove('text-amber-600', 'text-sm');
            priceDiv.classList.add('text-accent', 'text-lg');
          }
          radio.disabled = false;
          vehicleCard.style.opacity = '1';
          vehicleCard.style.cursor = 'pointer';
        }
      });
    }

    updateAddressLabels();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTunnel);
  } else {
    initTunnel();
  }
</script>

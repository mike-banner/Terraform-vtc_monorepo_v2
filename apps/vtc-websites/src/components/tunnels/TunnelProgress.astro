---
// src/components/tunnels/TunnelProgress.astro
const { currentStep = 1, totalSteps = 4, color = 'bg-primary' } = Astro.props;

const steps = [
  { number: 1, label: 'Détails du trajet' },
  { number: 2, label: 'Options & Véhicule' },
  { number: 3, label: 'Informations client' },
  { number: 4, label: 'Confirmation' },
];
---

<div class='w-full'>
  <div class='flex justify-between relative'>
    <!-- Ligne de progression -->
    <div class='absolute top-4 left-0 right-0 h-0.5 bg-ui-line -z-10'></div>
    <div
      id="progress-bar-line"
      class={`absolute top-4 left-0 h-0.5 ${color} -z-10 transition-all duration-500`}
      style={`width: ${((currentStep - 1) / (totalSteps - 1)) * 100}%`}>
    </div>

    <!-- Étapes -->
    {
      steps.slice(0, totalSteps).map((step) => (
        <div class='flex flex-col items-center relative'>
          <div
            data-step={step.number}
            class={`progress-step-circle w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300
            ${
              step.number < currentStep
                ? `bg-ui-ink text-white`
                : step.number === currentStep
                  ? `bg-ui-ink text-white ring-4 ring-primary/20`
                  : 'bg-ui-line text-ui-muted'
            }`}>
            {step.number}
          </div>
          <span
            data-step={step.number}
            class={`progress-step-label mt-1 text-xs font-medium text-center transition-colors duration-300
            ${step.number <= currentStep ? 'text-ui-ink' : 'text-ui-muted'}`}>
            {step.label}
          </span>
        </div>
      ))
    }
  </div>
</div>

---
// src/components/home/infoServicePremium.astro
---

<div class='mb-16 text-center'>
  <span class='text-[#6185B2] font-label font-bold tracking-[0.3em] uppercase text-xs block mb-3'
    >Excellence Concept</span
  >
  <h2
    class='text-[#0F172A] font-headline text-4xl md:text-6xl font-extrabold tracking-tighter uppercase'>
    Services Premium
  </h2>
</div>
<div class='grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10'>
  <!-- Service 1 -->
  <a
    href='/tunnels/transfert'
    class='group flex flex-col items-center text-center md:text-left md:items-start bg-white border border-slate-200/90 p-8 rounded-2xl shadow-sm hover:shadow-xl hover:border-[#6185B2] transition-all duration-300 block focus:outline-none'>
    <div class='mb-6 p-4 rounded-xl bg-[#6185B2]/10 text-[#6185B2] group-hover:bg-[#6185B2] group-hover:text-white transition-colors duration-300'>
      <span class='material-symbols-outlined text-4xl'>route</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-[#0F172A] mb-3 uppercase tracking-tight'>
      Transferts
    </h3>
    <p class='text-[#0F172A]/70 font-body leading-relaxed text-sm'>
      Accueil VIP personnalisé avec tablette nominative et suivi en temps réel de votre vol.
    </p>
  </a>
  <!-- Service 2 -->
  <a
    href='/tunnels/business'
    class='group flex flex-col items-center text-center md:text-left md:items-start bg-white border border-slate-200/90 p-8 rounded-2xl shadow-sm hover:shadow-xl hover:border-[#6185B2] transition-all duration-300 block focus:outline-none'>
    <div class='mb-6 p-4 rounded-xl bg-[#6185B2]/10 text-[#6185B2] group-hover:bg-[#6185B2] group-hover:text-white transition-colors duration-300'>
      <span class='material-symbols-outlined text-4xl'>auto_awesome</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-[#0F172A] mb-3 uppercase tracking-tight'>
      Événementiel
    </h3>
    <p class='text-[#0F172A]/70 font-body leading-relaxed text-sm'>
      Logistique de transport haut de gamme pour vos congrès, séminaires et célébrations privées.
    </p>
  </a>
  <!-- Service 3 -->
  <a
    href='/tunnels/availability'
    class='group flex flex-col items-center text-center md:text-left md:items-start bg-white border border-slate-200/90 p-8 rounded-2xl shadow-sm hover:shadow-xl hover:border-[#6185B2] transition-all duration-300 block focus:outline-none'>
    <div class='mb-6 p-4 rounded-xl bg-[#6185B2]/10 text-[#6185B2] group-hover:bg-[#6185B2] group-hover:text-white transition-colors duration-300'>
      <span class='material-symbols-outlined text-4xl'>history_toggle_off</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-[#0F172A] mb-3 uppercase tracking-tight'>
      Mise à Disposition
    </h3>
    <p class='text-[#0F172A]/70 font-body leading-relaxed text-sm'>
      Flexibilité absolue avec un chauffeur dédié pour la durée de vos besoins opérationnels.
    </p>
  </a>
</div>

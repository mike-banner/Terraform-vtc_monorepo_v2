---
// src/components/home/infoServicePremium.astro
---

<div class='mb-20 text-center'>
  <span class='text-elite-accent font-label font-bold tracking-[0.3em] uppercase text-[10px]'
    >Excellence Concept</span
  >
  <h2
    class='text-white font-headline text-4xl md:text-6xl font-extrabold tracking-tighter mt-4 uppercase'>
    Services Premium
  </h2>
</div>
<div class='grid grid-cols-1 md:grid-cols-3 gap-16'>
  <!-- Service 1 -->
  <a
    href='/tunnels/transfert'
    class='group flex flex-col items-center text-center md:text-left md:items-start border-b md:border-b-0 md:border-l border-white/10 pb-8 md:pb-0 pl-0 md:pl-8 hover:border-elite-accent transition-colors duration-500 block focus:outline-none'>
    <div class='mb-8 text-elite-accent'>
      <span class='material-symbols-outlined text-5xl'>route</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-white mb-4 uppercase tracking-tight'>
      Transferts
    </h3>
    <p class='text-white/50 font-body leading-relaxed text-sm'>
      Accueil VIP personnalise avec tablette nominative et suivi en temps reel de votre vol.
    </p>
  </a>
  <!-- Service 2 -->
  <a
    href='/tunnels/business'
    class='group flex flex-col items-center text-center md:text-left md:items-start border-b md:border-b-0 md:border-l border-white/10 pb-8 md:pb-0 pl-0 md:pl-8 hover:border-elite-accent transition-colors duration-500 block focus:outline-none'>
    <div class='mb-8 text-elite-accent'>
      <span class='material-symbols-outlined text-5xl'>auto_awesome</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-white mb-4 uppercase tracking-tight'>
      Evenementiel
    </h3>
    <p class='text-white/50 font-body leading-relaxed text-sm'>
      Logistique de transport haut de gamme pour vos congres, seminaires et celebrations privees.
    </p>
  </a>
  <!-- Service 3 -->
  <a
    href='/tunnels/availability'
    class='group flex flex-col items-center text-center md:text-left md:items-start pb-8 md:pb-0 border-b-0 md:border-l border-white/10 pl-0 md:pl-8 hover:border-elite-accent transition-colors duration-500 block focus:outline-none'>
    <div class='mb-8 text-elite-accent'>
      <span class='material-symbols-outlined text-5xl'>history_toggle_off</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-white mb-4 uppercase tracking-tight'>
      Mise a Disposition
    </h3>
    <p class='text-white/50 font-body leading-relaxed text-sm'>
      Flexibilite absolue avec un chauffeur dedie pour la duree de vos besoins operationnels.
    </p>
  </a>
</div>

---
// src/components/home/ServicesGrid.astro
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import availabilityImg from '../../assets/images/elite-availability.jpg';
import airportImg from '../../assets/images/elite-airport.jpg';
import businessImg from '../../assets/images/elite-business.jpg';
import longDistanceImg from '../../assets/images/elite-long-distance.jpg';

interface Service {
  title: string;
  image: string | ImageMetadata;
  desc: string;
  link: string;
}

const services: Service[] = [
  {
    title: "Transferts",
    image: airportImg,
    desc: "Service ponctuel vers gares, aéroports ou destinations sur-mesure.",
    link: "/tunnels/transfert"
  },
  {
    title: "Longue Distance",
    image: longDistanceImg,
    desc: "Déplacements interurbains dans toute la France sous 24h.",
    link: "/tunnels/long-distance"
  },
  {
    title: "Business & B2B",
    image: businessImg,
    desc: "Solutions de mobilité pour vos collaborateurs et VIP.",
    link: "/tunnels/business"
  },
  {
    title: "Mise à Disposition",
    image: availabilityImg,
    desc: "Un chauffeur à votre service à l'heure ou à la journée.",
    link: "/tunnels/availability"
  }
];
---

<div class="py-12 bg-transparent">
  <div class="text-center mb-16">
    <span class="text-xs font-bold uppercase tracking-[0.3em] text-[#6185B2] mb-3 block font-label">NOS PRESTATIONS</span>
    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-[#0F172A] leading-tight font-headline">
      L'excellence du <span class="text-[#6185B2]">sur-mesure</span>
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {services.map((s) => (
      <a href={s.link} class="relative group h-[400px] overflow-hidden rounded-2xl bg-[#0F172A] block shadow-md hover:shadow-2xl transition-all duration-500">
        <Image
          src={s.image as any}
          alt={s.title}
          width={800}
          height={400}
          class="w-full h-full object-cover transition-all duration-700 brightness-85 group-hover:brightness-60 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A]/90 via-[#0F172A]/30 to-transparent"></div>

        <div class="absolute inset-0 p-8 flex flex-col justify-end lg:translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
           <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#719DCC] mb-2 opacity-100 lg:opacity-0 group-hover:opacity-100 transition-opacity">Signature</span>
           <h4 class="text-xl font-bold text-white tracking-tight mb-2 uppercase font-headline">{s.title}</h4>
           <p class="text-white/80 text-xs font-normal leading-relaxed opacity-100 lg:opacity-0 group-hover:opacity-100 transition-opacity duration-300 font-body">
             {s.desc}
           </p>
        </div>

        <div class="absolute top-6 right-6 w-10 h-10 bg-[#6185B2] text-white flex items-center justify-center rounded-full opacity-100 lg:opacity-0 group-hover:opacity-100 transition-all duration-500 shadow-md">
           <Icon name="ri:arrow-right-line" class="text-lg" />
        </div>
      </a>
    ))}
  </div>
</div>

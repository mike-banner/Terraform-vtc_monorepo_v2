{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SITE_MAP"],
      "outputs": [".astro/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "gen:types": {
      "cache": false
    }
  }
}
